# Optional APP crash diagnostics.
# Public project ingestion key from PostHog Project Settings; this ships in the app binary.
# Do not put a Personal API Key / CLI token in any EXPO_PUBLIC_* variable.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# EAS Build only: enable automatic Hermes, dSYM, R8 and NDK symbol uploads.
# Set POSTHOG_CLI_API_KEY as an EAS Secret (Personal API Key with error tracking write
# and organization read scopes). Never commit its value or put it in EXPO_PUBLIC_*.
# The project ID and host are non-secret EAS environment variables.
POSTHOG_CLI_PROJECT_ID=715723
POSTHOG_CLI_HOST=https://us.posthog.com
# POSTHOG_CLI_API_KEY=  # Configure as an EAS Secret; do not populate in this file.
