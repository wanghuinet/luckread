# Optional APP crash diagnostics.
# Public project ingestion key from PostHog Project Settings; this ships in the APK.
# Configure EXPO_PUBLIC_POSTHOG_API_KEY as a GitHub Actions repository variable.
# Never put a Personal API Key / CLI token in any EXPO_PUBLIC_* variable.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# LuckRead's Android Beta workflow runs Expo prebuild + Gradle in GitHub Actions (not EAS Build).
# Configure POSTHOG_CLI_API_KEY as a GitHub Actions repository secret.
# Use a Personal API Key with error tracking write and organization read scopes.
# The project ID and CLI host are public configuration and are wired into the build workflow.
POSTHOG_CLI_PROJECT_ID=715723
POSTHOG_CLI_HOST=https://us.posthog.com
# POSTHOG_CLI_API_KEY=  # Configure as a GitHub Actions secret; never commit the value.
