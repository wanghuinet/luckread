{
  "expo": {
    "name": "LuckRead",
    "slug": "luckread",
    "version": "1.0.0",
    "scheme": "luckread",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "37.0.0",
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.2.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LuckRead needs access to your photos so you can attach pictures and short videos to posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luckread.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.luckread.app"
    }
  }
}
