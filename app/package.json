{
  "name": "luckread-native",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:api-client": "bun test tests/api-client.test.mjs",
    "check:api-boundary": "node scripts/verify-api-client-boundary.mjs",
    "check:compat": "expo install --check",
    "test:publish-api": "bun test tests/publish-api.test.mjs",
    "test:publish-flow": "bun test tests/publish-flow.test.mjs",
    "test:social-screen-api": "bun test tests/social-screen-api.test.mjs",
    "test:video-feed-api": "bun test tests/video-feed-api.test.mjs",
    "test:comment-navigation": "bun test tests/comment-navigation.test.mjs",
    "test:content-search": "bun test tests/content-search.test.mjs",
    "test:auth-flow": "bun test tests/auth-flow-api.test.mjs",
    "test:subscriptions-api": "bun test tests/subscriptions-api.test.mjs",
    "test:billing-api": "bun test tests/billing-api.test.mjs",
    "test:paid-content": "bun test tests/paid-content-entitlement.test.mjs",
    "test:native-menu": "bun test tests/native-menu-dependencies.test.mjs",
    "test:media-gallery": "bun test tests/feed-media-gallery.test.mjs",
    "postinstall": "node scripts/apply-hyperswitch-rn88-compat.mjs",
    "test:hyperswitch-compat": "bun test tests/hyperswitch-rn88-compat.test.mjs"
  },
  "dependencies": {
    "@codeherence/react-native-header": "^0.14.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5",
    "@nandorojo/galeria": "3.1.0",
    "@react-native-menu/menu": "2.0.0",
    "@react-navigation/bottom-tabs": "^7.0.5",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/native": "^7.0.3",
    "@shopify/flash-list": "2.3.2",
    "dayjs": "^1.11.13",
    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-collapsible-tab-view": "^8.0.1",
    "react-native-draggable-flatlist": "^4.0.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-sortables": "^1.5.2",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-tab-view": "^4.0.10",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "zustand": "^4.5.1",
    "expo-secure-store": "~58.0.2",
    "expo-image-picker": "~58.0.10",
    "@juspay-tech/react-native-hyperswitch": "1.3.6",
    "@sentry/react-native": "~8.28.0",
    "react-native-inappbrowser-reborn": "3.7.1",
    "expo-build-properties": "~58.0.12",
    "expo-updates": "~58.0.20",
    "expo-font": "~58.0.11",
    "expo-dev-client": "~58.0.18",
    "react-native-worklets": "0.13.0",
    "expo-splash-screen": "~58.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "ajv": "^8.12.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "eslintConfig": {
    "extends": "universe/native",
    "root": true
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-collapsible-tab-view"
        ]
      }
    }
  }
}
