  "cancelSubscription":{"path":{"subscriptionId":"ResourceId"},"headers":{"If-Match":"etag","Idempotency-Key":"required"},"requestBody":null},
  "getEntitlements":{"path":{"subjectId":"ResourceId"},"response":{"items":"Entitlement[]"}},
