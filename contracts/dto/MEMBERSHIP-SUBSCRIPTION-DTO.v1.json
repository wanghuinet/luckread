  "status":"CONTRACTED_NOT_VERIFIED",
  "sourceApiContract":"contracts/api/rc-04-06-share-subscription-entitlement.v1.json",
  "createSubscription":{"request":{"planId":"ResourceId"},"serverOwned":["subscriptionId","subscriberId","status","planVersion","startedAt","currentPeriodStart","currentPeriodEnd"]},
