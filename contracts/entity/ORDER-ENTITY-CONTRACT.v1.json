  "constraints": {
    "integerMinorUnitsOnly": true,
    "clientAmountsNeverAuthoritative": true,
    "totalFormula": "totalMinor = subtotalMinor - discountMinor + taxMinor",
    "orderSubtotalFormula": "subtotalMinor = sum(order lines lineSubtotalMinor)",
    "discountBound": "0 <= discountMinor <= subtotalMinor",
    "versionStartsAt": 1,
    "versionIncrementsExactlyOncePerAcceptedMutation": true,
    "customerIdentity": "customerId is server-derived from the authenticated principal.",
    "paymentLinkage": "Paid orders require verified provider payment evidence under admitted PAY-001; this Order does not duplicate Payment or Ledger authority."
  },
  "lifecycle": {
    "create": "Resolve item/offer and price versions server-side, then atomically create Order, immutable OrderLine rows and scoped idempotency state in D1-04.",
    "paymentPending": "Provider calls happen outside D1 transactions and must use stable idempotency.",
    "confirm": "Paid orders require validated provider result/reconciliation; zero-total orders require server-computed eligibility.",
    "cancel": "Use version compare-and-set; any required refund/reversal is a separate admitted financial operation.",
    "concurrency": "Last-Write-Wins is prohibited; every accepted mutable transition compare-and-sets version."
  },
  "security": {
    "ownerScopeServerDerived": true,
    "priceAndDiscountServerComputed": true,
    "clientCannotAssertPaidOrConfirmed": true,
    "crossDomainReferencesOpaque": true,
    "rawProviderPayloadNotPublicOrderData": true
  },
  "nonGoals": [
    "No public API/DTO admitted by this entity contract alone.",
    "No provider callback directly mutates Order, ledger, subscription or entitlement state.",
    "No Payload Collection or Payload Core change.",
    "No physical schema, migration execution or runtime implementation is claimed."
  ],
  "verificationRequirements": [
    "canonical API/DTO/permission admission",
    "D1-04 display-name preflight and migration/schema evidence",
    "atomic Order/OrderLine/idempotency tests",
    "duplicate-key replay and payload-conflict tests",
    "price and monetary invariant tests",
    "payment/cancel race and version-CAS tests",
    "exact-commit Evidence Registry provenance"
  ],
  "persistenceContract": "contracts/persistence/ORDER-D1-04-persistence.v1.json",
  "stateMachineRef": "contracts/state-machines/order.json",
  "relatedEntityIds": [
