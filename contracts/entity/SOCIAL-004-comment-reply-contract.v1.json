  "constraints": {
    "replyParentScope": "parentCommentId, when present, MUST resolve to a Comment in the same contentId scope.",
    "authorSource": "authorUserId is resolved from the authenticated server-side principal; clients cannot authoritatively set it.",
    "contentSource": "contentId is resolved from the canonical request path and must resolve to authoritative Content in D1-02.",
    "stateAuthority": "CommentState is authoritative for client-visible lifecycle state; W06 owns moderation decisions, not Comment storage ownership.",
    "visibility": "Server-side block/privacy/moderation policy MUST be evaluated before exposing or creating a Comment.",
    "idempotency": "Create Comment MUST converge under an identical Idempotency-Key and request identity."
  },
  "nonGoals": [
    "No moderation decision fields are duplicated into Comment.",
    "No comment counter is authoritative here.",
    "No Payload Collection authority is introduced.",
    "No cache/projection is authoritative.",
    "No runtime GREEN or persistence execution is claimed."
  ],
