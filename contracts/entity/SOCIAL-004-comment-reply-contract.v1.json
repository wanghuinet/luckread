      "D1-02 table/column evidence",
      "W05 physical Worker binding",
      "create/list runtime tests",
      "duplicate-idempotency test",
      "reply same-content scope negative test",
      "block/privacy/moderation negative tests",
      "concurrency evidence",
      "remote D1 runtime evidence",
      "Evidence Registry record"
    ],
    "promotionRule": "Remain CONTRACTED_NOT_VERIFIED until executable persistence/runtime/security/evidence chain is admitted."
  },
