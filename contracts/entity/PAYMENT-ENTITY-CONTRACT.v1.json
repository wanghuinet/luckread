  "constraints": [
    "customerId is server-derived from the authenticated principal and never accepted from a client request.",
    "The payment snapshot must match an owned positive payable Order's amount and currency at creation time.",
    "Provider calls occur outside D1 transactions and reuse the same payment ID and Idempotency-Key for retries. A given customer's key cannot be reused for a different order/request.",
    "Provider success is trusted only after verified provider evidence is validated against the local Payment and persisted with monotonic provider timestamp and local version CAS.",
    "No client secret, API key, card data, raw webhook body, ledger line or entitlement snapshot is persisted in this entity."
  ],
  "lifecycle": {
    "create": "Persist stable INITIATING payment identity and idempotency snapshot before calling the provider.",
    "update": "Use provider-specific immutable identity, resource.updated ordering, and version compare-and-set.",
    "terminal": "succeeded, failed, cancelled, cancelled_post_capture and expired payment attempts are never reopened; corrections/refunds/reversals are separate reconciled facts."
  },
  "security": {
    "ownerScope": "customerId is bound from the W01-authenticated principal.",
    "secretHandling": "Provider API keys and client secrets are never persisted or included in logs; client secret is returned only after merchant/payment/amount/currency checks and through an admitted checkout DTO.",
    "webhookHandling": "Verify raw-body HMAC-SHA512 and merchant identity before event persistence; persist event ID and raw payload SHA-256, never the raw body.",
    "privacy": "No public exposure of customerId, merchantId, idempotency key, request hash or failure internals."
  },
  "nonGoals": [
    "No Payment API is enabled by this contract alone.",
    "No ledger, refund, payout, settlement or entitlement grant is implemented by the Payment entity.",
    "No Payment or Entitlement authority is moved into D1-01 or Payload Core."
  ],
  "verificationRequirements": [
    "Offline migration checks",
    "Idempotent provider retry",
    "Merchant/payment/amount/currency mismatch rejection",
    "Signed webhook event deduplication",
    "same event ID different payload reconciliation",
    "stale/out-of-order event rejection",
    "owner isolation",
    "no raw secrets/payload persistence",
    "exact-commit Evidence Registry"
  ],
  "persistenceContract": "contracts/persistence/PAYMENT-D1-04-persistence.v1.json",
  "stateMachineRef": "contracts/state-machines/payment.json",
  "relatedEntityIds": [
    "ENT-ORDER"
  ],
  "promotionRule": "Remain CONTRACTED_NOT_VERIFIED until physical D1-04 migration/postflight, payment runtime, webhook replay/reconciliation, security, and exact-commit evidence pass."
}
