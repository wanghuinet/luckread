  "constraints": {
    "orderRelationship": "orderId is a logical same-D1-04 relation to ENT-ORDER.",
    "quantityMinimum": 1,
    "integerMinorUnitsOnly": true,
    "lineSubtotalFormula": "lineSubtotalMinor = unitAmountMinor * quantity",
    "lineTotalFormula": "lineTotalMinor = lineSubtotalMinor - lineDiscountMinor + lineTaxMinor",
    "snapshot": "itemSnapshotJson is bounded, validated and immutable; not a source authority."
  },
  "lifecycle": {
    "create": "Create OrderLine rows atomically with their parent Order; public clients cannot create standalone lines.",
    "update": "Item reference/version, quantity, snapshot and all monetary fields are immutable after order acceptance.",
    "delete": "Accepted order-line history is not destructively deleted."
  },
  "security": {
    "ownerScopeInheritedFromOrder": true,
    "clientCannotSetAmounts": true,
    "sourceItemResolvedServerSide": true,
    "crossDomainOwnershipNotTransferred": true
  },
