{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/entity/entity-implementation-evidence.v1.schema.json",
  "title": "Luckread Entity Implementation Evidence Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "sourceOfTruth", "records"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "status": { "type": "string", "enum": ["NOT_GREEN", "GREEN"] },
    "sourceOfTruth": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId", "catalogStatus", "implementationStatus", "implementationRefs", "schemaEvidenceRefs", "migrationEvidenceRefs", "payloadNativeEvidenceRefs", "extensionEvidenceRefs", "blockers", "status"],
        "properties": {
          "entityId": { "type": "string", "minLength": 1 },
          "catalogStatus": { "type": "string", "enum": ["VERIFIED", "PROPOSED", "BLOCKED"] },
          "implementationStatus": { "type": "string", "enum": ["IMPLEMENTED", "CONTRACT_ONLY", "BLOCKED"] },
          "implementationRefs": { "type": "array", "items": { "type": "string" } },
          "schemaEvidenceRefs": { "type": "array", "items": { "type": "string" } },
          "migrationEvidenceRefs": { "type": "array", "items": { "type": "string" } },
          "payloadNativeEvidenceRefs": { "type": "array", "items": { "type": "string" } },
          "extensionEvidenceRefs": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["NOT_GREEN", "VERIFIED", "BLOCKED"] }
        }
      }
    }
  }
}
