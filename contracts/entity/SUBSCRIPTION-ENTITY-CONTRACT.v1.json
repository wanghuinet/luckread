  "invariants": [
    "subscriptionId is globally unique and never reused.",
    "subscriberId is always bound to authoritative ENT-USER; the client cannot establish identity authority.",
    "planId + planVersion identifies the immutable plan definition used by the subscription.",
    "Exactly one authoritative current status exists for a subscription.",
    "Historical lifecycle transitions remain auditable and replay-safe.",
    "Payment/order state is referenced, not duplicated as financial authority.",
    "Entitlement is derived from valid subscription state but remains the authoritative access decision state in D1-01.",
    "Subscriber privacy is default-deny outside authorized scopes.",
    "Duplicate create/cancel/pause/resume/change-plan commands must converge idempotently under the Membership API contract.",
    "No field in this entity grants financial, social-graph or content authority."
  ],
  "stateMachineReconciliation": {
    "ref": "contracts/state-machines/subscription.json",
    "status": "RECONCILIATION_REQUIRED",
    "reason": "Membership contract and events define pause/resume semantics, while the current machine-readable state vocabulary does not yet include PAUSED. This entity contract therefore records status as the lifecycle field without silently inventing a new state.",
    "otherTerminology": "The capability contract uses startAt; the data contract uses startedAt. The entity canonical field is startedAt with startAt retained as a semantic alias, not a second persisted field."
  },
  "persistence": {
    "status": "NOT_BOUND",
    "note": "Physical D1-01 table/column binding, migration, Worker execution binding and runtime evidence are intentionally deferred until the state-machine/API reconciliation and global implementation gate admit them."
  },
  "persistence": {
    "status": "CONTRACTED_NOT_VERIFIED",
    "persistenceContract": "contracts/persistence/SUBSCRIPTION-D1-01-persistence.v1.json",
    "note": "Logical D1-01 table/column binding is now defined. Migration execution, W07 runtime binding, concurrency version source and active-subscription uniqueness policy remain unverified or pending decision."
  },
  "nonGoals": [
