  "stateDerivation": {
    "pendingEnrollment": "twoFactor row exists and verified=false; user.twoFactorEnabled must not authorize privileged actions",
    "activeVerified": "user.twoFactorEnabled=true AND twoFactor.verified=true AND mfaEnrolledAt is valid",
    "disabled": "user.twoFactorEnabled=false and factor removed; mfaEnrolledAt is null",
    "lockout": "lockedUntil is later than authoritative server time; reject verification",
    "assuranceRule": "Role assignment or a client-supplied boolean is never evidence of MFA. Read authoritative W02 fields on each privileged authorization path."
  },
  "securityInvariants": [
    "secret and backupCodes are never returned by storage reads or written to logs, events, caches, traces, or admin projections",
    "raw TOTP secret and plaintext recovery codes are only returned during the authenticated enrollment/rotation response and are never persisted in plaintext",
    "factor enrollment and disable require authenticated identity and step-up verification",
    "MFA enable/disable invalidates existing sessions; no trusted-device bypass is permitted for privileged access",
    "role grants at L5-L8 require user.twoFactorEnabled=true, factor.verified=true and a valid enrollment timestamp",
    "TOTP replay protection requires a durable atomic lastAcceptedTotpTimeStep check; current migration 0006 does not provide this field and the standard plugin path has not been verified to reject a repeated successful TOTP time-step",
    "failed-attempt, lockout, challenge expiry, replay and cross-account negative tests must pass before AUTH-007 can become GREEN"
  ],
  "verificationRequired": [
    "entity-catalog-admission",
    "entity-field-contract-admission",
    "authoritative-migration-includes-replay-state",
    "atomic-totp-replay-negative-test",
    "concurrent-same-totp-time-step-test",
    "challenge-expiry-and-replay-tests",
    "secret-and-recovery-code-redaction-test",
    "enable-disable-session-invalidation-test",
    "W01-W02-authenticated-end-to-end-tests",
    "real-D1-schema-readback",
    "mapping0-evidence-registry-admission"
  ],
