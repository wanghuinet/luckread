{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/security/auth-003-credential-hash-key-authority.json",
  "version": "1.0.0",
  "status": "CONTRACTED_IMPLEMENTATION_NOT_AUTHORIZED",
  "featureId": "AUTH-003",
  "purpose": "Authorize the server-side secret boundary used to derive ENT-CREDENTIAL valueHash without changing the existing persistence schema.",
  "owner": "W02_D1-01",
  "algorithm": "HMAC-SHA-256",
  "activeBinding": "AUTH003_CREDENTIAL_HASH_KEY",
  "previousBinding": "AUTH003_CREDENTIAL_HASH_KEY_PREVIOUS",
  "bindingRules": {
    "activeRequired": true,
    "previousOptional": true,
    "minimumSecretLength": 32,
    "bindingsAreServerSideOnly": true,
    "plaintextSecretMustNeverBePersisted": true,
    "secretMustNeverAppearInLogsOrEvidence": true,
    "purposeRestrictedTo": "AUTH-003 ENT-CREDENTIAL valueHash derivation and verification"
  },
  "rotation": {
    "model": "OVERLAP_THEN_RETIRE",
    "newCredentialsUse": "ACTIVE",
    "verificationMayUse": [
      "ACTIVE",
      "PREVIOUS"
    ],
    "previousKeyMayBeConfiguredOnlyDuringOverlap": true,
    "retirementCondition": "All existing credential hashes are either re-derived with ACTIVE during authorized verification/update or the previous key is otherwise proven unused before removal.",
    "noDatabaseKeyVersionRequired": true,
    "schemaChangeForKeyRotation": false
  },
  "failureMode": {
    "missingActiveKey": "FAIL_CLOSED",
    "invalidKeyMaterial": "FAIL_CLOSED",
    "missingPreviousKeyDuringNormalOperation": "ALLOWED",
    "rotationMaintenanceFailure": "FAIL_CLOSED_FOR_SENSITIVE_CREDENTIAL_MUTATIONS"
  },
  "nonGoals": [
    "No new D1 table or column",
    "No second credential-hashing authority",
    "No reuse of PAYLOAD_SECRET",
    "No secret material committed to source control",
    "No client-visible credential material",
    "No new Worker, Queue or D1"
  ],
  "securityReferences": [
    "docs/169-SECURITY-SECRET-KEY-LIFECYCLE-INCIDENT-CONTRACT-v1.0.md",
    "docs/71-PLATFORM-OPERATIONS-GOVERNANCE-RELIABILITY-CONTRACT-v1.0.md",
    "contracts/entity/AUTH-003-credential-field-contract.v1.json",
    "workers/W02-content/src/credentials/credential-add.ts"
  ]
}
