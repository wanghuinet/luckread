  "status": "OWNER_DELEGATED_POLICY",
  "ownerDecision": {
    "renameCooldownDays": 30,
    "reservedNamePolicy": "EXACT_NORMALIZED_MATCH",
    "historicalUsernames": "PERMANENTLY_UNAVAILABLE_FOR_REUSE"
