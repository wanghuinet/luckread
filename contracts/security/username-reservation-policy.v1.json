  "username": {
    "inputNormalization": [
      "trim",
      "unicode_nfc",
      "casefold"
    ],
    "acceptedCharacters": "ASCII letters and digits only",
    "minLength": 6,
    "maxLength": 32,
    "displayValue": "Preserve trimmed NFC display casing",
    "normalizedValue": "Lowercase canonical value; accepted usernames are ASCII, so lowercase is equivalent to casefold"
  },
