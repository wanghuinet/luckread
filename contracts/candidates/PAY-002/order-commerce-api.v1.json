{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/candidates/pay-002/order-commerce-api.v1.json",
  "title": "Commerce Purchase Order Create / Read API Candidate",
  "version": "1.0.0",
  "status": "CONTRACT_ADMITTED_RUNTIME_PENDING",
  "operations": [
    {
      "operationId": "createCommerceOrder",
      "method": "POST",
      "path": "/commerce/orders",
      "auth": {
        "required": true,
        "permission": "order.create",
        "scope": "own",
        "permissionStatus": "ADMITTED"
      },
      "request": {
        "headers": {
          "Idempotency-Key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "required": true
          }
        },
        "body": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "required": [
                  "itemRef",
                  "quantity"
                ],
                "additionalProperties": false,
                "properties": {
                  "itemRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "Opaque item/offer reference. W07 must resolve item kind, version and current eligibility through the authoritative owner; client claims do not prove an item is purchasable."
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              }
            }
          },
          "rules": [
            "customerId, itemType, itemVersion, currency, prices, discount, tax, totals, payment status and provider identifiers are not accepted from the client.",
            "Repeated itemRef entries in one request are rejected; clients must send one line with the combined quantity.",
            "The same authenticated customer + operation + Idempotency-Key + semantic request hash replays the first completed response; key reuse with a different request hash is rejected.",
            "This paid-checkout path rejects any zero-priced item and any computed order total below one minor currency unit until a separate zero-charge fulfillment contract is admitted.",
            "Item kind, immutable item version, currency, unit price, discounts and tax are server-resolved. Unsupported or unresolved items fail closed."
          ]
        }
      },
      "success": {
        "status": 201,
        "idempotent": true,
        "responseDTO": "CommerceOrderResponse"
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "PRECONDITION_REQUIRED",
        "IDEMPOTENCY_KEY_REUSE_CONFLICT",
        "IDEMPOTENCY_IN_PROGRESS",
        "CONFLICT",
        "SERVICE_UNAVAILABLE"
      ],
      "auditRequired": true,
      "concurrency": {
        "strategy": "ATOMIC_CREATE_AND_IDEMPOTENCY_RECORD_IN_D1_04"
      },
      "candidateStatus": "CONTRACTED_PENDING_RUNTIME"
    },
    {
      "operationId": "getCommerceOrder",
      "method": "GET",
      "path": "/commerce/orders/{orderId}",
      "auth": {
        "required": true,
        "permission": "order.read",
        "scope": "own",
        "permissionStatus": "ADMITTED"
      },
      "request": {
        "path": {
          "orderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "required": true
          }
        }
      },
      "success": {
        "status": 200,
        "responseDTO": "CommerceOrderResponse"
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "VALIDATION_FAILED",
        "RATE_LIMITED"
      ],
      "auditRequired": false,
      "scopeRules": [
        "Resource owner is bound to the authenticated server principal.",
        "An inaccessible order is returned as RESOURCE_NOT_FOUND to avoid cross-owner resource enumeration."
      ],
      "candidateStatus": "CONTRACTED_PENDING_RUNTIME"
    }
  ],
  "dtoSchemas": {
    "CommerceOrderLineResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemRef",
        "quantity",
        "unitAmountMinor",
        "lineSubtotalMinor",
        "lineDiscountMinor",
        "lineTaxMinor",
        "lineTotalMinor"
      ],
      "properties": {
        "itemRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "unitAmountMinor": {
          "type": "integer",
          "minimum": 1
        },
        "lineSubtotalMinor": {
          "type": "integer",
          "minimum": 0
        },
        "lineDiscountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "lineTaxMinor": {
          "type": "integer",
          "minimum": 0
        },
        "lineTotalMinor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "invariants": [
        "lineSubtotalMinor = unitAmountMinor * quantity",
        "lineTotalMinor = lineSubtotalMinor - lineDiscountMinor + lineTaxMinor"
      ]
    },
    "CommerceOrderData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "status",
        "version",
        "currency",
        "subtotalMinor",
        "discountMinor",
        "taxMinor",
        "totalMinor",
        "items",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "PENDING_PAYMENT",
            "CONFIRMED",
            "PROCESSING",
            "COMPLETED",
            "CANCELLED",
            "FAILED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "subtotalMinor": {
          "type": "integer",
          "minimum": 0
        },
        "discountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "taxMinor": {
          "type": "integer",
          "minimum": 0
        },
        "totalMinor": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/dtoSchemas/CommerceOrderLineResponse"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "invariants": [
        "totalMinor = subtotalMinor - discountMinor + taxMinor",
        "All amounts use integer minor units and one explicit currency."
      ]
    },
    "CommerceOrderResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "requestId"
      ],
      "properties": {
        "data": {
          "$ref": "#/dtoSchemas/CommerceOrderData"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
