        "single_live_or_successful_attempt_per_order": {
          "type": "UNIQUE_INDEX",
          "required": true,
          "where": "status NOT IN ('failed','cancelled','cancelled_post_capture','expired')",
          "invariant": "An order cannot own two active or successful payment attempts; a new attempt is allowed after a terminal failure/cancel/expiry."
        }
      },
      "invariants": [
        "A Payment must reference an owned Order in CREATED/PENDING_PAYMENT with the same positive total and currency.",
        "UNIQUE(customer_id, idempotency_key) scopes the payment creation key to a customer; key reuse for a different order/request conflicts.",
        "Provider request runs outside a D1 transaction, using the same stable payment_id and idempotency_key on retries.",
        "Provider resource.updated is monotonic; every stored mutation advances local version exactly once.",
        "Terminal payment attempts are not reopened.",
        "A partial unique index permits only one non-failed/non-cancelled/non-expired payment attempt per order; a confirmed successful payment cannot be double-charged by a second attempt."
      ]
    },
    "payment_provider_events": {
      "purpose": "Durable deduplication/reconciliation inbox for authenticated, signature-verified provider events; never raw event payload storage.",
      "primaryKey": "event_row_id",
      "columns": {
        "event_row_id": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "provider": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "merchant_id": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true,
          "apiExposure": "NONE"
        },
        "event_id": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "event_type": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "payment_id": {
          "type": "TEXT",
          "required": false,
          "nullable": true,
          "immutable": true
