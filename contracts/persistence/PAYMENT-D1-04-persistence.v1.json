        "event_data_json": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true,
          "format": "json",
          "maxUtf8Bytes": 16384,
          "privacy": "Allowlisted event fields only; subscriber_attributes and raw request body are excluded."
        },
        "payload_sha256": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true,
          "format": "sha-256"
        },
        "state": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "allowedValues": [
            "RECEIVED",
            "APPLIED",
            "RECONCILIATION_REQUIRED",
            "IGNORED"
          ]
        },
        "received_at": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true,
          "format": "date-time"
        },
        "processed_at": {
          "type": "TEXT",
          "required": false,
          "nullable": true,
          "format": "date-time"
        },
        "outcome_code": {
          "type": "TEXT",
          "required": false,
          "nullable": true,
          "maxLength": 128
        }
      },
      "invariants": [
        "UNIQUE(app_id,event_id) is the RevenueCat webhook event identity within an explicitly allowlisted app.",
        "Same event identity and same raw payload SHA-256 is an idempotent duplicate; same identity with a different hash creates a separate conflict fact.",
        "Only the immutable original receipt is retained; raw webhook bytes and subscriber_attributes are never stored.",
        "A durable receipt alone never creates a Payment, activates a Subscription, or grants a content entitlement.",
        "Webhook event content is a hint for reconciliation; the current subscriber state must be read through RevenueCat's server API before applying subscription state."
      ],
      "indexes": [
