          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "state": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "allowedValues": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "occurrence_count": {
          "type": "INTEGER",
          "required": true,
          "nullable": false,
          "monotonic": true
        },
        "version": {
          "type": "INTEGER",
          "required": true,
          "nullable": false,
          "optimisticConcurrency": true
        },
        "first_seen_at": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "last_seen_at": {
          "type": "TEXT",
          "required": true,
          "nullable": false
        },
        "resolved_at": {
          "type": "TEXT",
          "required": false,
          "nullable": true
        },
        "resolution_code": {
          "type": "TEXT",
          "required": false,
          "nullable": true
        }
      },
      "invariants": [
        "Unique provider + merchant ID + event ID + incoming payload hash deduplicates repeated observation of the same conflict variant.",
        "existing_payload_sha256 and incoming_payload_sha256 must differ; a same-hash replay belongs to the normal idempotent inbox path.",
        "Occurrence count may advance by at most one per version-CAS update; last_seen_at cannot regress.",
        "Resolution is explicit and terminal; resolved anomaly facts cannot be reopened or deleted.",
        "No raw webhook body, API key, client secret or cardholder data is stored.",
        "A conflict row can be inserted only when an immutable provider event receipt exists for the same provider, merchant, event ID, and existing payload hash."
      ]
    },
    "revenuecat_webhook_events": {
      "purpose": "Durable idempotent inbox for authenticated RevenueCat store-subscription lifecycle events. This is provider-event transport evidence only; RevenueCat's current subscriber API and LuckRead's immutable product-plan mapping are re-read before any subscription state change.",
