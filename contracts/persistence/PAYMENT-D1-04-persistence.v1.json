          "required": true,
          "nullable": false,
          "immutable": true
        },
        "state": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "allowedValues": [
            "RECEIVED",
            "APPLIED",
            "RECONCILIATION_REQUIRED",
            "REJECTED"
          ]
        },
        "received_at": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "processed_at": {
          "type": "TEXT",
          "required": false,
          "nullable": true
        },
        "outcome_code": {
          "type": "TEXT",
          "required": false,
          "nullable": true
        }
      },
      "invariants": [
        "UNIQUE(provider, merchant_id, event_id) is the durable webhook deduplication key.",
        "A duplicate event ID with the same payload hash is a replay; different payload hash requires reconciliation.",
        "Raw webhook body, provider secret, client secret, card data, and entitlement information are never stored.",
        "APPLIED and REJECTED receipts remain immutable. Only mandate_active/mandate_revoked receipts in RECONCILIATION_REQUIRED may be reopened to RECEIVED for exact same event ID and payload SHA after the local source payment/mandate is available; the immutable event identity cannot change.",
        "When supplied in a signed mandate_details webhook, payment_id is retained as a safe local correlation field to bind the event to the exact setup payment; raw webhook body is never retained."
      ]
    },
    "payment_provider_event_conflicts": {
      "purpose": "Durable anomaly/reconciliation facts when an authenticated provider reuses an event ID with a different payload hash; the first verified receipt remains immutable.",
      "primaryKey": "conflict_id",
      "columns": {
        "conflict_id": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "provider": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "merchant_id": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true,
          "apiExposure": "NONE"
        },
        "event_id": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
        "existing_payload_sha256": {
          "type": "TEXT",
          "required": true,
          "nullable": false,
          "immutable": true
        },
