  "tables": {
    "payments": {
      "purpose": "Durable provider-backed payment attempt state and immutable request/commercial snapshot; not a ledger or entitlement store.",
      "primaryKey": "payment_id",
      "entityId": "ENT-PAYMENT",
      "columns": {
        "payment_id": {
