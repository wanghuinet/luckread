  "constraints": {
    "subscriptionIdUnique": "subscription_id is the primary key and is never reused.",
    "subscriberReference": "subscriber_id references authoritative ENT-USER by stable identifier only; no cross-D1 physical foreign key.",
    "planVersionReference": "plan_id + plan_version identifies the immutable plan definition consumed by the subscription.",
    "statusAuthority": "status is constrained by contracts/state-machines/subscription.json.",
    "financialIsolation": "No payment, order, ledger, wallet or settlement facts are persisted as Subscription authority.",
    "entitlementIsolation": "entitlement_snapshot_ref is a reference only; Entitlement remains its own authority.",
    "privacy": "subscriber_id is not a public identifier and must be exposed only through authorized scoped APIs.",
    "versionMonotonic": "version starts at 1 and increments exactly once per successful authoritative mutation."
  },
  "concurrency": {
    "required": true,
    "apiBoundary": "If-Match / expected-version semantics from Membership API contract.",
    "physicalVersionField": "ENT-SUBSCRIPTION-F-VERSION",
    "decision": "The Subscription entity field contract now defines version as the authoritative concurrency source. If-Match/expectedVersion MUST compare-and-set against this field; ETag remains representation metadata only.",
    "status": "CONTRACTED_NOT_VERIFIED"
  },
  "uniqueness": {
    "activeSubscriptionKey": "NOT_YET_FIXED",
    "reason": "Membership Data Contract requires prevention of duplicate active subscriptions where business policy requires it, but the authoritative policy does not yet define whether the business key is subscriber-only, subscriber+plan, creator scope, organization scope, or another combination.",
    "rule": "No speculative unique constraint may be introduced until the applicable Membership policy/plan scope contract resolves the active-subscription uniqueness boundary.",
    "status": "DECISION_REQUIRED"
  },
