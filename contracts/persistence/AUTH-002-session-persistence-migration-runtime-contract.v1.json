{
  "version": "1.0",
  "status": "CONTRACTED_NOT_VERIFIED",
  "featureId": "AUTH-002",
  "entityId": "ENT-SESSION",
  "fieldContractRef": "contracts/entity/AUTH-002-session-field-contract.v1.json",
  "authority": {
    "domainId": "D1-01",
    "entityStatus": "PROPOSED_UNTIL_RUNTIME_EVIDENCE",
    "persistenceStatus": "REQUIRED_BEFORE_VERIFIED"
  },
  "persistence": {
    "store": "D1",
    "databaseDomain": "D1-01",
    "table": "sessions",
    "tableAuthority": "CONTRACT_ONLY_UNTIL_MIGRATION_EVIDENCE",
    "primaryKey": "id",
    "foreignKeys": [
      { "column": "userId", "references": "users.id", "onDelete": "RESTRICT" },
      { "column": "deviceId", "references": "device_records.id", "onDelete": "RESTRICT" }
    ],
    "columns": [
      { "fieldId": "ENT-SESSION-F-ID", "column": "id", "dbType": "TEXT", "nullable": false, "primaryKey": true },
      { "fieldId": "ENT-SESSION-F-USER-ID", "column": "user_id", "dbType": "TEXT", "nullable": false },
      { "fieldId": "ENT-SESSION-F-DEVICE-ID", "column": "device_id", "dbType": "TEXT", "nullable": false },
      { "fieldId": "ENT-SESSION-F-TOKEN-VERSION", "column": "token_version", "dbType": "INTEGER", "nullable": false },
      { "fieldId": "ENT-SESSION-F-REFRESH-CREDENTIAL-HASH", "column": "refresh_credential_hash", "dbType": "TEXT", "nullable": false },
      { "fieldId": "ENT-SESSION-F-EXPIRES-AT", "column": "expires_at", "dbType": "TEXT", "nullable": false },
      { "fieldId": "ENT-SESSION-F-REVOKED-AT", "column": "revoked_at", "dbType": "TEXT", "nullable": true },
      { "fieldId": "ENT-SESSION-F-CREATED-AT", "column": "created_at", "dbType": "TEXT", "nullable": false },
      { "fieldId": "ENT-SESSION-F-LAST-SEEN-AT", "column": "last_seen_at", "dbType": "TEXT", "nullable": true }
    ],
    "indexes": [
      "sessions_user_id_idx",
      "sessions_device_id_idx",
      "sessions_token_version_idx",
      "sessions_expires_at_idx",
      "sessions_revoked_at_idx",
      "sessions_created_at_idx"
    ],
    "uniqueness": [],
    "secrets": {
      "rawAccessToken": "FORBIDDEN",
      "rawRefreshToken": "FORBIDDEN",
      "password": "FORBIDDEN",
      "refreshCredentialHash": "HASHED_DERIVED_ONLY"
    }
  },
  "migration": {
    "required": true,
    "artifactMustBeVersioned": true,
    "forwardMigrationMustBeDeterministic": true,
    "rollbackPolicy": "NO_DATA_LOSS; compensating migration required where rollback is destructive",
    "mustProve": [
      "table and columns match the canonical field contract",
      "nullability and primary-key semantics match",
      "foreign-key targets are authoritative",
      "indexes required by contract exist",
      "no plaintext credential column exists",
      "migration is idempotent or execution is protected from duplicate application",
      "applied migration version is observable"
    ],
    "forbidden": [
      "silent field addition",
      "silent field rename",
      "semantic type change",
      "dropping session data without an explicit contracted lifecycle operation",
      "creating duplicate session representations outside the canonical table"
    ]
  },
  "runtime": {
    "authLogin": {
      "writes": [
        "create one session row after successful authentication",
        "bind user_id and device_id",
        "initialize token_version",
        "persist only hashed refresh credential",
        "persist expires_at and created_at"
      ],
      "mustNotWrite": [
        "raw access token",
        "raw refresh token",
        "password",
        "client-controlled token_version",
        "role or entitlement fields"
      ],
      "readRequirements": [
        "resolve authoritative user/account state",
        "resolve device binding",
        "enforce credential and anti-abuse policy before session creation"
      ]
    },
    "authLogout": {
      "writes": [
        "set revoked_at for the targeted current session",
        "operation is idempotent"
      ],
      "mustNotWrite": [
        "delete the authoritative audit history",
        "mutate unrelated sessions unless explicitly requested by a different contracted operation"
      ]
    },
    "sessionValidation": {
      "mustCheck": [
        "session exists",
        "user association is authoritative",
        "device binding is valid",
        "token_version matches the authoritative invalidation contract",
        "revoked_at is null",
        "expires_at is in the future"
      ],
      "failClosed": true,
      "cacheMayAccelerateButNotOverrideAuthority": true
    },
    "refreshRotation": {
      "oldCredentialInvalidatedBeforeReuse": true,
      "replayMustFail": true,
      "newCredentialHashReplacesOldHash": true,
      "concurrentRotationMustNotCreateTwoValidSuccessors": true
    }
  },
  "transactionAndConcurrency": {
    "sessionCreate": "single durable write boundary",
    "logout": "conditional update by session id and current authority",
    "refreshRotation": "compare-and-update / transactional equivalent",
    "concurrentRevocation": "idempotent",
    "concurrentRefresh": "at most one rotation succeeds for the same predecessor credential"
  },
  "evidenceRequirements": [
    "actual D1 schema inspection",
    "versioned migration file reference",
    "applied migration execution result",
    "runtime authLogin handler reference",
    "runtime authLogout handler reference",
    "session validation test evidence",
    "refresh rotation concurrency evidence",
    "revocation idempotency evidence",
    "expiry enforcement evidence",
    "foreign-key integrity evidence",
    "secret non-persistence evidence",
    "Evidence Registry execution record"
  ],
  "stopConditions": [
    "implementation schema differs from field contract",
    "migration is missing or unverifiable",
    "raw token or password is persisted",
    "revoked or expired sessions can authenticate",
    "refresh replay succeeds",
    "concurrent rotation produces multiple valid credentials",
    "runtime behavior depends on undocumented fields",
    "evidence is planned but not executed"
  ],
  "readiness": {
    "contract": "CLOSED_FOR_IMPLEMENTATION_INPUT",
    "migration": "NOT_EXECUTED",
    "runtime": "NOT_IMPLEMENTED_OR_VERIFIED",
    "tests": "NOT_EXECUTED",
    "evidence": "NOT_BOUND",
    "entityPromotion": "BLOCKED"
  }
}
