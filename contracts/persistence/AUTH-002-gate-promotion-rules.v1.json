{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/persistence/AUTH-002-gate-promotion-rules.v1.json",
  "title": "AUTH-002 Evidence Gate Promotion Rules",
  "version": "1.1.0",
  "status": "CONTRACTED",
  "rules": {
    "gate1": {
      "name": "REMOTE_SCHEMA_CATALOG",
      "promotionState": "NOT_EVALUATED_UNTIL_EXECUTED",
      "passState": "GATE1_PASS",
      "requires": [
        "all Gate-1 artifact files",
        "controlled remote D1 environment",
        "database identity",
        "commit identity",
        "locked dependency identity",
        "successful read-only migration status",
        "users physical catalog/schema evidence",
        "evidence hashes",
        "sensitive-data exclusion"
      ],
      "doesNotProve": [
        "native session runtime representation",
        "login lifecycle correlation",
        "logout lifecycle correlation",
        "refresh semantics",
        "session extension persistence"
      ]
    },
    "gate2": {
      "name": "NATIVE_SESSION_RUNTIME",
      "promotionState": "NOT_EVALUATED_UNTIL_EXECUTED",
      "passState": "GATE2_PASS",
      "requires": [
        "Payload 3.87.1 runtime identity",
        "disposable controlled authentication flow",
        "login-to-session-id correlation",
        "native session persistence correlation",
        "session validation correlation",
        "logout removal correlation",
        "refresh expiry correlation",
        "secret non-persistence"
      ]
    },
    "finalPromotion": {
      "auth002": "BLOCKED_UNTIL_GATE1_AND_GATE2_AND_MIGRATION_AND_SECURITY_E2E",
      "entSession": "BLOCKED_UNTIL_GATE1_AND_GATE2_AND_MIGRATION_AND_SECURITY_E2E"
    }
  },
  "invariants": [
    "No Gate-1 artifact may be represented as final session runtime evidence.",
    "No migration may be admitted solely from Gate-1 evidence.",
    "No independent canonical sessions table may be introduced as a shortcut.",
    "No sensitive authentication secret may enter evidence artifacts."
  ]
}
