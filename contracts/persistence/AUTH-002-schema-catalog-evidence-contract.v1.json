{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/persistence/AUTH-002-schema-catalog-evidence-contract.v1.json",
  "title": "AUTH-002 Remote D1 Schema Catalog Evidence Contract",
  "version": "1.0.0",
  "status": "CONTRACTED_NOT_EXECUTED",
  "scope": "REMOTE_SCHEMA_CATALOG_ONLY",
  "requiredFiles": [
    "d1-info.json",
    "migration-status.json",
    "catalog.json",
    "users-schema.json",
    "users-indexes.json",
    "users-foreign-keys.json",
    "manifest.json"
  ],
  "requiredMetadata": [
    "testedCommitSha",
    "environmentClass",
    "databaseName",
    "payloadVersion",
    "payloadLockedVersion",
    "d1AdapterVersion",
    "d1AdapterLockedVersion",
    "nodeVersion",
    "wranglerVersion",
    "executedAt",
    "evidenceFiles"
  ],
  "environmentClass": {
    "const": "CONTROLLED_REMOTE_D1"
  },
  "requiredQueries": [
    "remote D1 info",
    "remote D1 migration status",
    "sqlite_schema catalog",
    "PRAGMA table_info(users)",
    "PRAGMA index_list(users)",
    "PRAGMA foreign_key_list(users)"
  ],
  "prohibitedEvidenceContent": [
    "password",
    "raw_access_token",
    "raw_refresh_token",
    "refresh_credential_hash",
    "cookie",
    "authorization_header",
    "cloudflare_secret",
    "production_user_record"
  ],
  "acceptance": {
    "allRequiredFilesPresent": true,
    "schemaMustBeDatabaseQueried": true,
    "commitMustMatchTestedSource": true,
    "dependencyMustMatchLockfile": true,
    "noSyntheticSchemaAllowed": true,
    "migrationCommandMustNotMutateDatabase": true,
    "nativeSessionRuntimeCorrelationIsNotSatisfied": true
  },
  "promotion": {
    "schemaCatalogGate": "PASS_ONLY_WHEN_ALL_REQUIRED_EVIDENCE_ACCEPTED",
    "nativeSessionRuntimeGate": "REMAINS_REQUIRED",
    "entSession": "BLOCKED",
    "auth002": "BLOCKED"
  }
}
