{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/persistence/AUTH-001-registration-envelope.v1.json",
  "title": "AUTH-001 Registration Envelope",
  "version": "1.0.0",
  "status": "CONTRACTED_PARTIAL",
  "sourceOfTruth": "docs/change-control/CC-MAPPING-0-AUTH-001-REGISTRATION-ENVELOPE-WRITER-BOUNDARY-2026-09-27.md",
  "canonicalIdempotencySource": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md",
  "canonicalRegistrationResponseSource": "contracts/openapi/v1/openapi.yaml#/paths/~1auth~1register/post/responses/201/content/application~1json/schema",
  "scope": "registration-local internal record at W01",
  "transactionBoundary": "same W01 Payload transaction as native User creation",
  "retentionHours": 24,
  "fields": {
    "idempotency_key": {
      "type": "string",
      "source": "contracts/schemas/common/idempotency-key.json"
    },
    "scope": {
      "type": "string",
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "endpoint": {
      "type": "string",
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "payload_hash": {
      "type": "string",
      "encoding": "SHA-256 of normalized JSON payload",
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "state": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "COMPLETED",
        "FAILED"
      ],
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "response_digest": {
      "type": "string",
      "requiredWhen": "state=COMPLETED",
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "committed_response": {
      "type": "object",
      "required": [
        "userId",
        "accountState"
      ],
      "properties": {
        "userId": {
          "$ref": "contracts/openapi/v1/openapi.yaml#/components/schemas/ResourceId",
          "canonicalDestination": "ENT-USER.id",
          "securityRule": "immutable cross-domain authority"
        },
        "accountState": {
          "$ref": "contracts/enums/account-state.json",
          "canonicalDestination": "users.account_state",
          "initialValue": "PENDING_VERIFICATION",
          "initialVersion": 1
        }
      },
      "requiredWhen": "state=COMPLETED",
      "description": "Lossless logical representation of the canonical AUTH-001 201 response body required for deterministic replay."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "retention": "default 24h",
      "source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md"
    },
    "consent_record_id": {
      "type": "string",
      "canonicalEntity": "ENT-CONSENT",
      "requiredWhen": "state=COMPLETED",
      "source": "contracts/persistence/PRIV-002-consent-persistence-contract.v1.json",
      "description": "Internal committed consent record identifier created in the same W01 registration transaction."
    }
  },
  "semanticRules": [
    "same key + same payload + COMPLETED returns the first registration result without creating another User",
    "same key + same payload + IN_PROGRESS returns IDEMPOTENCY_IN_PROGRESS",
    "same key + different payload returns IDEMPOTENCY_KEY_REUSE_CONFLICT",
    "expired key is treated as a new request",
    "the envelope write shares the same transaction as the protected registration User write",
    "a COMPLETED replay returns HTTP 201 and the exact committed_response body {userId, accountState} from the first successful registration",
    "accountState in committed_response is sourced from users.account_state; the admitted initial value is PENDING_VERIFICATION with account_state_version 1",
    "HTTP 201 is a deterministic operation-level response status from the canonical authRegister contract and does not require a second persisted status field",
    "the registration envelope records consent_record_id for the committed ENT-CONSENT record",
    "a COMPLETED replay does not create another consent record and reuses the first committed consent_record_id"
  ],
  "blockedBindings": {},
  "nonAuthorizations": [
    "No generic idempotency platform",
    "No new Worker/D1/Queue",
    "No runtime implementation",
    "No migration",
    "No Mapping 0 GREEN"
  ],
  "consentBinding": {
    "status": "CONTRACTED",
    "entityId": "ENT-CONSENT",
    "purpose": "ACCOUNT_REGISTRATION",
    "legalBasis": "CONSENT",
    "initialState": "GRANTED",
    "policyVersionSource": "authRegister.request.consent.policyVersion",
    "resourceBinding": "ENT-USER.id",
    "ownerBinding": "ENT-USER.id",
    "retentionClass": "LEGAL_AUDIT",
    "retentionUntilRule": "SERVER_CALCULATED_FROM_APPLICABLE_RETENTION_POLICY"
  }
}
