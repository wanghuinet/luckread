{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/persistence/AUTH-002-schema-evidence-manifest.v1.json",
  "title": "AUTH-002 Schema Evidence Manifest",
  "version": "1.0.0",
  "status": "CONTRACTED_NOT_EXECUTED",
  "requiredFiles": [
    "dependency.json",
    "migration-status.json",
    "users-schema.json",
    "session-representation.json",
    "runtime-lifecycle.json",
    "manifest.json"
  ],
  "requiredMetadata": [
    "testedCommitSha",
    "environmentClass",
    "payloadVersion",
    "d1AdapterVersion",
    "nodeVersion",
    "executedAt",
    "evidenceFileSha256"
  ],
  "environmentClass": {
    "enum": [
      "CONTROLLED_LOCAL",
      "CONTROLLED_REMOTE_D1"
    ]
  },
  "prohibitedEvidenceContent": [
    "password",
    "raw_access_token",
    "raw_refresh_token",
    "refresh_credential_hash",
    "cookie",
    "authorization_header",
    "cloudflare_secret",
    "production_user_record"
  ],
  "acceptance": {
    "allRequiredFilesPresent": true,
    "schemaMustBeDatabaseQueried": true,
    "sessionRepresentationMustBeRuntimeCorrelated": true,
    "commitMustMatchTestedSource": true,
    "dependencyMustMatchLockfile": true,
    "noSyntheticSchemaAllowed": true
  },
  "promotion": {
    "entSession": "BLOCKED_UNTIL_ALL_EVIDENCE_ACCEPTED",
    "auth002": "BLOCKED_UNTIL_ALL_EVIDENCE_ACCEPTED"
  }
}
