{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/capability/capability-contract-graph.v1.schema.json",
  "title": "Luckread Capability Contract Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sourceOfTruth", "status", "features"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "sourceOfTruth": {"const": "docs/00-LUCKREAD-ULTIMATE-FEATURE-BLUEPRINT-v2.0.md"},
    "status": {"enum": ["NOT_GREEN", "GREEN"]},
    "features": {
      "type": "array",
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "refArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "hierarchy", "name", "owner", "status", "exposure"],
      "properties": {
        "featureId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+-[0-9]{3,}$"},
        "hierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["l1", "l2", "l3", "l4"],
          "properties": {
            "l1": {"type": "string", "minLength": 1},
            "l2": {"type": "string", "minLength": 1},
            "l3": {"type": "string", "minLength": 1},
            "l4": {"type": "string", "minLength": 1}
          }
        },
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "owner": {"type": "string", "minLength": 1},
        "businessObject": {"type": "string"},
        "status": {"enum": ["PROPOSED", "CONTRACTED", "IMPLEMENTATION_PENDING", "IMPLEMENTED", "VERIFIED", "DEPRECATED", "REMOVED"]},
        "exposure": {"enum": ["PUBLIC_API", "CLIENT", "ADMIN", "INTERNAL", "INFRASTRUCTURE"]},
        "apiOperationIds": {"$ref": "#/$defs/refArray"},
        "domainEntityIds": {"$ref": "#/$defs/refArray"},
        "persistenceMappingIds": {"$ref": "#/$defs/refArray"},
        "permissionIds": {"$ref": "#/$defs/refArray"},
        "scopeIds": {"$ref": "#/$defs/refArray"},
        "stateMachineId": {"type": ["string", "null"]},
        "eventIds": {"$ref": "#/$defs/refArray"},
        "queueJobIds": {"$ref": "#/$defs/refArray"},
        "cachePolicyId": {"type": ["string", "null"]},
        "dependencies": {"$ref": "#/$defs/refArray"},
        "evidenceIds": {"$ref": "#/$defs/refArray"}
      }
    }
  }
}
