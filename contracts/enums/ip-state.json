{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/enums/ip-state.json",
  "title": "IPState",
  "description": "IP lifecycle state. Canonical Source: docs/304 section 3.3.",
  "type": "string",
  "enum": [
    "DRAFT",
    "PENDING_VERIFICATION",
    "VERIFIED",
    "ACTIVE",
    "SUSPENDED",
    "TRANSFERRING",
    "DISSOLVED"
  ],
  "x-luckread": {
    "canonical-source": "docs/304-ORGANIZATION-ENTERPRISE-AND-IP-PRINCIPAL-CONTRACT-v1.0.md",
    "domain": "D1-01",
    "authoritative-writer": "W00",
    "initial-state": "DRAFT",
    "terminal-states": ["DISSOLVED"],
    "dissolve-preconditions": [
      "no_in_flight_transactions",
      "no_unsettled_revenue",
      "content_relocated",
      "licenses_resolved"
    ]
  }
}
