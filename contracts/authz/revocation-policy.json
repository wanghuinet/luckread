{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/authz/revocation-policy.json",
  "title": "Authorization Revocation and Cache Validity Policy",
  "type": "object",
  "required": ["authoritativeInvalidators", "versionDimensions", "cacheRule", "failMode"],
  "properties": {
    "authoritativeInvalidators": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"},
      "minItems": 8
    },
    "versionDimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"},
      "minItems": 5
    },
    "cacheRule": {"enum": ["VERSION_MATCH_REQUIRED"]},
    "failMode": {"enum": ["FAIL_CLOSED"]}
  },
  "x-luckread": {
    "authoritativeInvalidators": [
      "ACCOUNT_SECURITY_STATE",
      "CREDENTIAL_REVOCATION",
      "PERMISSION_REVOCATION",
      "MEMBERSHIP_REVOCATION",
      "SCOPE_REVOCATION",
      "ENTITLEMENT_REVOCATION",
      "DELEGATION_REVOCATION",
      "OWNERSHIP_TRANSFER"
    ],
    "versionDimensions": [
      "authorizationVersion",
      "credentialVersion",
      "membershipVersion",
      "entitlementVersion",
      "delegationVersion"
    ]
  }
}
