{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/authz/permissions.json",
  "title": "Permission Catalog",
  "description": "Canonical resource.action permission catalog. APIs MUST authorize against permissions, never against role names alone. Canonical Source: docs/04-P0-PERMISSION-RBAC-CONTRACT-v1.0.md + docs/301.",
  "type": "object",
  "required": ["permissions"],
  "properties": {
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "resource", "action", "minLayer"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
          "resource": { "type": "string" },
          "action": { "type": "string" },
          "minLayer": { "type": "string", "pattern": "^L[0-8]$" },
          "scope": { "enum": ["platform", "organization", "ip", "own", "public"] },
          "sensitive": { "type": "boolean" },
          "auditRequired": { "type": "boolean" }
        }
      }
    }
  },
  "x-luckread": {
    "rule": "Authorize on permission + scope, never on role name alone.",
    "deny-precedence": true
  },
