{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/authz/authz-cache-invariant.json",
  "title": "Authorization Cache Security Invariants",
  "description": "Machine-readable form of AUTHZ-CACHE-INVARIANT-001..004. Canonical Source: docs/302. Contract CI MUST fail if any implementation deviates.",
  "type": "object",
  "required": ["invariants"],
  "properties": {
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "severity"],
        "properties": {
          "id": { "type": "string", "pattern": "^AUTHZ-CACHE-INVARIANT-[0-9]{3}$" },
          "statement": { "type": "string" },
          "severity": { "enum": ["P0", "P1"] },
          "failMode": { "enum": ["fail-closed", "fail-open"] }
        }
      }
    }
  },
  "x-luckread": {
    "canonical-source": "docs/302-AUTHORIZATION-CACHE-SECURITY-CONTRACT-v1.0.md",
    "arch-invariant": "ARCH-INVARIANT-003"
  },
  "x-invariants": [
    {
      "id": "AUTHZ-CACHE-INVARIANT-001",
      "statement": "Cache HIT != Authorization Proof. Any cache hit MUST re-verify against the authoritative source before放行/rendering/returning.",
      "severity": "P0",
      "failMode": "fail-closed"
    },
    {
      "id": "AUTHZ-CACHE-INVARIANT-002",
      "statement": "Authorization evaluation failure MUST fail closed. Missing input => DENY.",
      "severity": "P0",
      "failMode": "fail-closed"
    },
    {
      "id": "AUTHZ-CACHE-INVARIANT-003",
      "statement": "Cache keys MUST include the full security principal dimension set.",
      "severity": "P0",
      "failMode": "fail-closed"
    },
    {
      "id": "AUTHZ-CACHE-INVARIANT-004",
      "statement": "Permission revocation MUST trigger deterministic invalidation with a bounded window.",
      "severity": "P0",
      "failMode": "fail-closed"
    }
  ],
  "x-principal-dimensions": [
    "subject_id",
    "account_state_version",
    "role_version",
    "entitlement_version",
    "subscription_version",
    "organization_version",
    "policy_version",
    "session_id",
    "token_version"
  ],
  "x-cache-key-template": "authz:{policy_version}:{subject_id}:{account_state_version}:{role_version}:{entitlement_version}:{subscription_version}:{organization_version}:{resource_type}:{resource_scope}:{action}",
  "x-banned-cache-objects": [
    "authorization-decision-boolean-used-for-allow",
    "account-state-as-truth",
    "session-or-token-validity",
    "unfiltered-search-results",
    "unfiltered-feed-results"
  ],
  "x-ttl-ceiling-seconds": {
    "authorization-input": 60,
    "authorized-payload-authenticated": 300,
    "public-content": 900,
    "permission-snapshot-ui-only": 300
  },
  "x-revocation-sla-seconds": {
    "ban-freeze-token-revoke": 10,
    "role-permission-revoke": 30,
    "subscription-entitlement-change": 60
  },
  "x-sensitive-operations-cache-mode": "none",
  "x-required-tests": [
    "user-a-to-user-b",
    "org-a-to-org-b",
    "admin-to-normal-user",
    "paid-to-free",
    "active-to-banned",
    "granted-to-revoked",
    "concurrent-revoke-and-request",
    "cache-key-missing-dimension",
    "cache-service-down",
    "token-version-mismatch",
    "temporary-permission-expired",
    "org-or-ip-member-removed"
  ]
}
