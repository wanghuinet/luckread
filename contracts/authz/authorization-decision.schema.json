{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/authz/authorization-decision.schema.json",
  "title": "LuckRead Authorization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["authenticated","account_state_allows","subject_type_allows","permission_allows","scope_allows","resource_allows","policy_allows","required_approval_allows","business_state_allows","credential_allows","decision"],
  "properties": {
    "authenticated": {"type":"boolean"},
    "account_state_allows": {"type":"boolean"},
    "subject_type_allows": {"type":"boolean"},
    "permission_allows": {"type":"boolean"},
    "scope_allows": {"type":"boolean"},
    "resource_allows": {"type":"boolean"},
    "policy_allows": {"type":"boolean"},
    "required_approval_allows": {"type":"boolean"},
    "business_state_allows": {"type":"boolean"},
    "credential_allows": {"type":"boolean"},
    "decision": {"type":"string","enum":["ALLOW","DENY"]},
    "reason_code": {"type":"string"},
    "policy_version": {"type":"string"}
  }
}
