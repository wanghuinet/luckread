{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/common/idempotency-key.json",
  "title": "Idempotency Key",
  "description": "Client-generated idempotency key. Same key + same payload MUST yield the first response; same key + different payload MUST yield IDEMPOTENCY_KEY_REUSE_CONFLICT.",
  "type": "string",
  "minLength": 16,
  "maxLength": 255,
  "pattern": "^[A-Za-z0-9_-]+$",
  "x-luckread": {
    "canonical-source": "docs/305-CONCURRENCY-ETAG-CONDITIONAL-REQUEST-AND-IDEMPOTENCY-CONTRACT-v1.0.md",
    "header": "Idempotency-Key",
    "retention-hours": 24,
    "mandatory-endpoints": ["payment", "subscription-change", "content-publish"]
  }
}
