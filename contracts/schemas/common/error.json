{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/common/error.json",
  "title": "API Error",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "../../enums/error-code.json"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["code", "message", "details"],
  "additionalProperties": false
}
