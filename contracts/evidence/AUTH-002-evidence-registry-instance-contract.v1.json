{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/evidence/AUTH-002-evidence-registry-instance-contract.v1.json",
  "title":"AUTH-002 Evidence Registry Instance Contract",
  "version":"1.0.0",
  "status":"CONTRACTED",
  "featureId":"AUTH-002",
  "failClosed":true,
  "sourceContract":"docs/176-EVIDENCE-REGISTRY-ACCEPTANCE-TRACEABILITY-CONTRACT-v1.0.md",
  "purpose":"Bind executable AUTH-002 evidence units to the exact tested commit without allowing empty, stale or documentation-only evidence to promote the feature.",
  "requiredEvidenceTypes":[
    "CI",
    "INTEGRATION_TEST",
    "SECURITY",
    "PERFORMANCE"
  ],
  "requiredClaims":[
    "PERSISTENCE_SCHEMA",
    "MIGRATION_EXECUTION",
    "RUNTIME_PERSISTENCE",
    "SECURITY_NEGATIVE",
    "CONCURRENCY",
    "MAPPING0_VALIDATION"
  ],
  "entryContract":{
    "requiredFields":["evidenceId","type","claimId","subjectType","subjectId","source","sourceRef","commitSha","timestamp","producer","result","status"],
    "resultValues":["PASS","FAIL","BLOCKED","NOT_APPLICABLE"],
    "statusValues":["CREATED","VERIFIED","ACTIVE","SUPERSEDED","EXPIRED","INVALIDATED"],
    "sourceMustBeExecutable":true,
    "sourceRefMustBeResolvable":true,
    "commitShaRequired":true,
    "timestampRequired":true
  },
  "promotionRules":{
    "registryMustBeNonEmpty":true,
    "everyRequiredClaimMustHaveEvidence":true,
    "everyEvidenceCommitMustEqualTestedCommit":true,
    "everyRequiredClaimMustResolveToPASS":true,
    "documentationOnlyCannotSatisfyClaim":true,
    "staleEvidenceCannotSatisfyClaim":true,
    "failedOrBlockedEvidenceCannotSatisfyClaim":true,
    "historicalFailureEvidenceMustNotBeDeleted":true,
    "mapping0EvidenceMustReferenceFinalValidatorRun":true
  },
  "claimBindings":{
    "PERSISTENCE_SCHEMA":{"minimumType":"CI","subjectType":"AUTH_FEATURE","subjectId":"AUTH-002"},
    "MIGRATION_EXECUTION":{"minimumType":"CI","subjectType":"AUTH_FEATURE","subjectId":"AUTH-002"},
    "RUNTIME_PERSISTENCE":{"minimumType":"INTEGRATION_TEST","subjectType":"AUTH_FEATURE","subjectId":"AUTH-002"},
    "SECURITY_NEGATIVE":{"minimumType":"SECURITY","subjectType":"AUTH_FEATURE","subjectId":"AUTH-002"},
    "CONCURRENCY":{"minimumType":"INTEGRATION_TEST","subjectType":"AUTH-002","subjectId":"AUTH-002"},
    "MAPPING0_VALIDATION":{"minimumType":"CI","subjectType":"AUTH_FEATURE","subjectId":"AUTH-002"}
  },
  "redactionRules":{
    "forbiddenSecretFields":["authorization","cookie","password","accessToken","rawAccessToken","refreshToken","rawRefreshToken","refreshCredentialHash","apiSecret","CLOUDFLARE_API_TOKEN","CLOUDFLARE_ACCOUNT_ID"],
    "forbiddenSecretValues":true
  },
  "instanceRequirement":{
    "path":"artifacts/evidence/auth-002/registry.json",
    "mustContain":"non-empty array of evidence entries satisfying entryContract and claimBindings",
    "emptyArrayFails":true
  },
  "promotionState":"BLOCKED_UNTIL_REGISTRY_AND_MAPPING0_PASS"
}
