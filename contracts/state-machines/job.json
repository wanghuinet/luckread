{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/state-machines/job.json",
  "title": "Job State Machine",
  "type": "object",
  "x-luckread": {
    "state-field": "status",
    "requires-optimistic-lock": true,
    "terminal-states": ["SUCCEEDED", "FAILED", "CANCELED"]
  },
  "x-transitions": [
    {"from":"QUEUED","to":"RUNNING","actor":"worker|system"},
    {"from":"QUEUED","to":"CANCELED","actor":"system|admin"},
    {"from":"RUNNING","to":"SUCCEEDED","actor":"worker"},
    {"from":"RUNNING","to":"FAILED","actor":"worker|system"},
    {"from":"RUNNING","to":"CANCELED","actor":"system|admin"},
    {"from":"FAILED","to":"QUEUED","actor":"system|admin"}
  ],
  "x-forbidden": [
    {"from":"SUCCEEDED","to":"RUNNING"},
    {"from":"SUCCEEDED","to":"QUEUED"},
    {"from":"CANCELED","to":"RUNNING"},
    {"from":"CANCELED","to":"QUEUED"}
  ]
}
