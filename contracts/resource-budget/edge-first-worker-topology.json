{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "edge-first-worker-topology",
  "version": "1.0.0",
  "status": "ARCHITECTURE_LOCKED",
  "logical_workers": [
    "W01_API_EDGE",
    "W02_IDENTITY_ACCOUNT",
    "W03_RISK_ABUSE",
    "W04_AUTHORIZATION_POLICY",
    "W05_CONTENT",
    "W06_MEDIA",
    "W07_SOCIAL_FEED",
    "W08_EVENT_NOTIFICATION",
    "W09_DISCOVERY",
    "W10_CREATOR_COMMERCE",
    "W11_CONTROL_PLATFORM",
    "W12_RECOMMENDATION",
    "W13_REALTIME"
  ],
  "physical_workers": [
    {"id":"P01","name":"edge-api","logical":["W01_API_EDGE"]},
    {"id":"P02","name":"security","logical":["W02_IDENTITY_ACCOUNT","W03_RISK_ABUSE","W04_AUTHORIZATION_POLICY"]},
    {"id":"P03","name":"public-content-feed","logical":["W05_CONTENT","W07_SOCIAL_FEED","W09_DISCOVERY"],"read_policy":"CACHE_FIRST"},
    {"id":"P04","name":"interaction","logical":["W07_SOCIAL_FEED"],"write_policy":"SINGLE_AUTHORITATIVE_WRITE"},
    {"id":"P05","name":"media-gateway-delivery","logical":["W06_MEDIA"],"large_object_policy":"STREAM_EXTERNAL_OBJECTS"},
    {"id":"P06","name":"creator-commerce","logical":["W10_CREATOR_COMMERCE"]},
    {"id":"P07","name":"event-notification-control","logical":["W08_EVENT_NOTIFICATION","W11_CONTROL_PLATFORM"],"async_default":true},
    {"id":"P08","name":"recommendation-realtime","logical":["W12_RECOMMENDATION","W13_REALTIME"],"isolated_runtime":true}
  ],
  "defaults": {
    "public_get_d1_reads_normal": 0,
    "public_get_d1_reads_cache_miss_target": 1,
    "public_get_d1_writes": 0,
    "simple_interaction_authoritative_writes_target": 1,
    "domain_events_per_mutation_target": 1,
    "sync_rpc_public_read_target_max": 1,
    "sync_rpc_write_target_max": 1,
    "single_flight_required_for_cache_miss": true,
    "retry_budget_scope": "REQUEST",
    "queue_is_bounded": true,
    "anti_abuse_before_expensive_work": true
  },
  "required_resource_dimensions": [
    "D1_READ","D1_WRITE","D1_READ_ROWS","D1_WRITE_ROWS",
    "D1_READ_BYTES","D1_WRITE_BYTES","RPC_CALLS","CPU_TIME",
    "WALL_TIME","RETRY_COUNT","EVENT_COUNT","EVENT_FANOUT",
    "QUEUE_OPERATIONS","R2_OPERATIONS","R2_BYTES","CACHE_OPERATIONS",
    "OUTBOUND_REQUESTS","REQUEST_BODY_BYTES","RESPONSE_BYTES","CONCURRENCY"
  ],
  "forbidden_patterns": [
    "PUBLIC_GET_DEFAULT_D1",
    "CACHE_MISS_UNBOUNDED_D1_FANIN",
    "SYNCHRONOUS_PROJECTION_WRITE_AMPLIFICATION",
    "WORKER_LOCAL_INDEPENDENT_RETRY_BUDGET",
    "SYNCHRONOUS_EVENT_FANOUT",
    "UNBOUNDED_QUEUE",
    "REALTIME_PER_MESSAGE_D1_WRITE",
    "LARGE_MEDIA_BUFFER_IN_WORKER",
    "UNBOUNDED_CANDIDATE_SET",
    "UNBOUNDED_PAGINATION",
    "N_PLUS_1_QUERY",
    "N_PLUS_1_RPC"
  ],
  "green_requires": [
    "cache_policy",
    "read_write_classification",
    "d1_budget",
    "row_byte_budget",
    "single_flight",
    "retry_budget",
    "rpc_budget",
    "event_fanout_budget",
    "queue_budget",
    "anti_abuse_policy",
    "idempotency",
    "private_cache_safety",
    "load_shed_policy",
    "n_plus_1_check",
    "unbounded_work_check"
  ],
  "change_policy": "CORE_ARCHITECTURE_CONTRACT_CHANGE"
}
