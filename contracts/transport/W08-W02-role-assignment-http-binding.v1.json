{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/transport/W08-W02-role-assignment-http-binding.v1.json",
  "title": "W08 to W02 Creator RoleAssignment Command Binding",
  "version": "1.0.0",
  "status": "CONTRACTED_PARTIAL",
  "caller": {
    "logicalWorker": "W08",
    "role": "Creator / Organization / Creator Qualification",
    "authority": "Approved creator application or scope appointment only"
  },
  "callee": {
    "logicalWorker": "W02",
    "role": "Identity / Account / Authorization",
    "authority": "Sole RoleAssignment writer on D1-01"
  },
  "transport": {
    "kind": "Cloudflare Worker Service Binding HTTP",
    "binding": "W02_AUTH",
    "targetWorker": "luckread-w02",
    "publicExposure": false
  },
  "operation": {
    "operationId": "grantCreatorBusinessRole",
    "method": "POST",
    "internalPath": "/internal/authz/role-assignment",
    "callerHeader": "X-LuckRead-Caller: W08",
    "transportVersion": "X-LuckRead-Transport-Version: 1.0",
    "principalSource": "W02 independently resolves the current session and global L0-L8 layer from Better Auth and D1-01",
    "approverMinimumLayer": "L7",
    "targetGate": [
      "target user exists",
      "account_state is ACTIVE",
      "email_verified is true",
      "effective global verified_user assignment exists"
    ],
    "allowedRoleScopePairs": [
      { "roleId": "creator", "scopeType": "global", "scopeId": null, "layer": "L3" },
      { "roleId": "ip_principal", "scopeType": "ip", "scopeId": "required", "layer": "L4" },
      { "roleId": "mcn_admin", "scopeType": "organization", "scopeId": "required", "layer": "L4" },
      { "roleId": "mcn_editor", "scopeType": "organization", "scopeId": "required", "layer": "L4" }
    ],
    "idempotency": "approvalRef is server-generated by W08 and becomes the deterministic RoleAssignment id",
    "scopeSource": "W08 verifies active scope and appointment facts before calling; a RoleAssignment alone never creates organization membership or IP ownership",
    "audit": "W08 persists the decision/appointment actor and state before command dispatch; W02 returns the authoritative assignment id"
  },
  "security": {
    "clientRoleInput": "forbidden",
    "unknownRoles": "fail closed",
    "globalRoleFromScopedAssignment": "forbidden",
    "revokedAssignmentReactivationByReplay": "forbidden",
    "approverIdentityFromRequestBody": "forbidden",
    "approverSessionForwarding": "restricted to the private W08-to-W02 call for independent session revalidation; never logged",
    "crossD1Transaction": false
  },
  "failurePolicy": {
    "timeoutMs": 2000,
    "automaticRetries": 0,
    "retryRule": "Same approvalRef may be replayed only when the same exact assignment is already ACTIVE; a revoked or different assignment fails closed",
    "statusMapping": {
      "unauthenticated": 401,
      "permissionDenied": 403,
      "invalidRequest": 400,
      "assignmentConflict": 409,
      "dependencyUnavailable": 503
    }
  },
  "topologyConstraints": {
    "newWorker": false,
    "newD1": false,
    "roleAssignmentAuthority": "D1-01 / W02"
  },
  "implementationStatus": {
    "source": "IMPLEMENTED_ON_FEATURE_BRANCH",
    "productionDeployment": "PENDING",
    "runtimeEvidence": "PENDING"
  }
}
