  "minimumTransportDecision": {
    "logicalPath": "W01 authenticated public ingress -> trusted server-side admission context -> W01 to W05 internal transport -> W05 authoritative D1-02 mutation",
    "transportKind": "Cloudflare Worker Service Binding HTTP",
    "bindingName": "W05_SOCIAL",
    "publicExposure": false,
    "newWorkerCount": 0,
    "newD1Count": 0,
    "newPayloadCollectionCount": 0,
    "newPublicOperationCount": 0,
    "decisionStatus": "TRANSPORT_CONTRACT_ADMITTED / 2 AUTHORITY INPUTS PENDING"
  },
  "operationBudgets": {
    "follow": {
      "d1ReadMax": 1,
      "d1WriteMax": 1,
      "rpcMax": 0,
      "asyncEventMax": 1
    },
    "unfollow": {
      "d1ReadMax": 0,
      "d1WriteMax": 1,
      "rpcMax": 0,
      "asyncEventMax": 1
    }
  },
  "failClosedRules": [
    "Missing or ambiguous trusted authority input produces DENY.",
    "actorUserId MUST originate from the authenticated server principal.",
    "Client input MUST NOT establish actor account state, permission result, block policy, privacy scope, anti-abuse result, counters, or relation state.",
    "No cache, projection, copied D1 record, or raw event may substitute for an admitted authority.",
    "The W05 authoritative mutation MUST remain inside the existing W05/D1-02 boundary.",
    "No synchronous business-Worker fan-out is introduced for Follow/Unfollow."
  ],
  "implementationAdmissionEvidenceRequired": [
    "explicit authority binding for actor account state",
    "explicit operational authority binding for target followability",
    "explicit authority binding for block policy",
    "explicit operational authority binding for privacy/audience scope",
    "explicit authority binding for anti-abuse admission",
    "admitted private W01->W05 transport contract and exact binding name",
    "exact source SHA provenance for each admitted boundary",
    "negative evidence for missing/forged trusted inputs",
    "positive/duplicate/concurrency evidence for the W05 D1-02 mutation"
  ],
  "nonAuthorizations": [
    "Does not authorize a new Service Binding.",
    "Does not authorize a new Worker or D1 database.",
    "Does not authorize a W05 runtime handler.",
    "Does not authorize a W05 call to W02 or W06 for policy lookup.",
    "Does not introduce a second policy authority or policy store.",
    "Does not promote SOCIAL-001 or SOCIAL-002 to GREEN.",
    "Does not promote Mapping 0 to GREEN."
  ],
  "sourceRefs": [
    "contracts/transport/SOCIAL-001-follow-trusted-admission-input.v1.json",
    "contracts/api/interaction-operation-policy.v1.json",
    "contracts/authz/authorization-decision.json",
    "contracts/authz/permissions.json",
    "contracts/state-machines/account.json",
    "contracts/api/block-mute.v1.json",
    "docs/11-P0-SOCIAL-INTERACTION-AND-EVENT-CONTRACT-v1.0.md",
    "docs/188-L5-L6-SOCIAL-COMMUNITY-INTERACTION-INSTANCE-REGISTRY-v1.0.md",
    "contracts/transport/W01-W05-social-follow-http-binding.v1.json"
  ],
  "transportContract": "contracts/transport/W01-W05-social-follow-http-binding.v1.json",
  "notes": "Existing authority contracts are now explicitly bound for actor principal, account state, follow permission, target identity, block policy, anti-abuse admission and caller provenance. Only target followability and privacy/audience operational authority remain unresolved."
