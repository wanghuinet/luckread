      "clientWritable": true,
      "serverResolved": true,
      "status": "SOURCE_EXISTS_BOUND_TO_ADMITTED_CONTRACT"
    },
    {
      "field": "targetFollowability",
      "authority": "Authoritative Social/Creator/User followability policy",
      "supportingContracts": [
