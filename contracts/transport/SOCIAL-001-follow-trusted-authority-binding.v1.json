      "authority": "D1-01 account-state authority",
      "supportingContracts": [
        "contracts/state-machines/account.json",
        "contracts/authz/authorization-decision.json"
      ],
      "clientWritable": false,
      "status": "SOURCE_EXISTS_BOUND_TO_ADMITTED_CONTRACT"
    },
    {
      "field": "followPermission",
      "authority": "Canonical authorization decision + permission catalog",
      "supportingContracts": [
        "contracts/authz/authorization-decision.json",
        "contracts/authz/permissions.json",
        "contracts/api/interaction-operation-policy.v1.json"
      ],
