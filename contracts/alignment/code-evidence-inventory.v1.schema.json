{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/alignment/code-evidence-inventory.schema.json",
  "title":"Luckread Code Evidence Inventory v1",
  "type":"object",
  "required":["version","status","sourceOfTruth","records"],
  "properties":{
    "version":{"const":"1.0.0"},
    "status":{"enum":["DISCOVERED","NOT_GREEN","BLOCKED"]},
    "sourceOfTruth":{"type":"string","minLength":1},
    "generatedBy":{"type":"string","minLength":1},
    "records":{"type":"array","items":{"type":"object","required":["evidenceId","subjectType","subjectId","implementationStatus","sourceRefs"],"properties":{
      "evidenceId":{"type":"string","minLength":1},
      "subjectType":{"enum":["FEATURE","ENTITY","FIELD","API_OPERATION","PAYLOAD_COLLECTION","PAYLOAD_FIELD"]},
      "subjectId":{"type":"string","minLength":1},
      "implementationStatus":{"enum":["IMPLEMENTED","PARTIAL","NOT_IMPLEMENTED","UNRESOLVED"]},
      "implementationRefs":{"type":"array","items":{"type":"string"}},
      "testRefs":{"type":"array","items":{"type":"string"}},
      "schemaEvidenceRefs":{"type":"array","items":{"type":"string"}},
      "sourceRefs":{"type":"array","minItems":1,"items":{"type":"string"}},
      "blockers":{"type":"array","items":{"type":"string"}}
    }}}
  },
  "additionalProperties":false
}
