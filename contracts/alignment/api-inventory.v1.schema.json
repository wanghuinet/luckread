{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/alignment/api-inventory.schema.json",
  "title":"Luckread API Alignment Inventory v1",
  "type":"object",
  "required":["version","status","sourceOfTruth","records"],
  "properties":{
    "version":{"const":"1.0.0"},
    "status":{"enum":["DISCOVERED","NOT_GREEN","BLOCKED"]},
    "sourceOfTruth":{"type":"string","minLength":1},
    "generatedBy":{"type":"string","minLength":1},
    "records":{"type":"array","items":{"type":"object","required":["operationId","method","path","domain","status","sourceRefs"],"properties":{
      "operationId":{"type":"string","minLength":1},
      "method":{"enum":["GET","POST","PUT","PATCH","DELETE","HEAD","OPTIONS"]},
      "path":{"type":"string","pattern":"^/v1/"},
      "domain":{"type":"string","minLength":1},
      "status":{"type":"string","enum":["DRAFT","CONTRACTED","IMPLEMENTED","INTEGRATED","STABLE","DEPRECATED","REMOVED"]},
      "featureIds":{"type":"array","items":{"type":"string"}},
      "schemaRef":{"type":"string"},
      "openapiRef":{"type":"string"},
      "sourceRefs":{"type":"array","minItems":1,"items":{"type":"string"}}
    }}}
  },
  "additionalProperties":false
}
