{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/alignment/payload-inventory.schema.json",
  "title":"Luckread Payload Alignment Inventory v1",
  "type":"object",
  "required":["version","status","sourceOfTruth","records"],
  "properties":{
    "version":{"const":"1.0.0"},
    "status":{"enum":["DISCOVERED","NOT_GREEN","BLOCKED"]},
    "sourceOfTruth":{"type":"string","minLength":1},
    "generatedBy":{"type":"string","minLength":1},
    "records":{"type":"array","items":{"type":"object","required":["collection","collectionSourceRef","origin","fields","sourceRefs"],"properties":{
      "collection":{"type":"string","minLength":1},
      "collectionSourceRef":{"type":"string","minLength":1},
      "origin":{"enum":["PAYLOAD_CONFIG_DISCOVERED","UNRESOLVED"]},
      "auth":{"type":"boolean"},
      "fields":{"type":"array","items":{"type":"object","required":["name","type","sourceRef","origin"],"properties":{
        "name":{"type":"string","minLength":1},
        "type":{"type":"string","minLength":1},
        "sourceRef":{"type":"string","minLength":1},
        "origin":{"enum":["PAYLOAD_CONFIG_DISCOVERED","UNRESOLVED"]},
        "required":{"type":"boolean"},
        "unique":{"type":"boolean"},
        "defaultValue":{},
        "hasAccess":{"type":"boolean"}
      }}},
      "sourceRefs":{"type":"array","minItems":1,"items":{"type":"string"}}
    }}}
  },
  "additionalProperties":false
}
