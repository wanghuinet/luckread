{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/alignment/cross-system-mapping.v1.schema.json",
  "title": "Luckread Five-Way Cross-System Mapping Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "sourceOfTruth", "generatedBy", "generatedDeterministically", "recordCount", "blockers", "records"],
  "properties": {
    "version": { "const": "1.0.0" },
    "status": { "enum": ["GREEN", "NOT_GREEN", "DISCOVERED", "BLOCKED"] },
    "sourceOfTruth": {
      "const": "docs/00-LUCKREAD-ULTIMATE-FEATURE-BLUEPRINT-v2.0.md + contracts/alignment/feature-inventory.v1.json"
    },
    "generatedBy": { "const": "scripts/consolidate-mapping-batches.mjs" },
    "generatedDeterministically": { "const": true },
    "recordCount": { "type": "integer", "minimum": 0 },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "status", "apiOperationIds", "entityIds", "payloadCollections", "codeEvidenceRefs", "evidence", "blockers"],
        "properties": {
          "featureId": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["GREEN", "MATCH", "MAPPED", "PARTIAL", "MISSING", "EXTRA", "DRIFT", "CONFLICT", "DUPLICATE", "UNRESOLVED", "BLOCKED"]
          },
          "apiOperationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "entityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "payloadCollections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "codeEvidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "securityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "lifecycleIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
