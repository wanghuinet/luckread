{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/alignment/five-way-alignment.v1.schema.json",
  "title": "Luckread Five-Way Alignment Contract",
  "description": "Machine-readable contract for aligning Blueprint features, persistence/data, APIs, Payload capabilities, and implementation code, with evidence as the verification layer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "principle", "systems", "alignmentStates", "rules"],
  "properties": {
    "version": {"const": "1.0.0"},
    "status": {"enum": ["DRAFT", "ACTIVE", "NOT_GREEN"]},
    "principle": {"const": "ONE_FEATURE_MODEL_MUST_BE_EXPLAINABLE_ACROSS_FEATURE_DB_API_PAYLOAD_CODE_AND_EVIDENCE"},
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "database", "api", "payload", "code", "evidence"],
      "properties": {
        "feature": {"const": "BLUEPRINT"},
        "database": {"const": "DATA_AND_PERSISTENCE"},
        "api": {"const": "API_CONTRACT"},
        "payload": {"const": "PAYLOAD_CAPABILITY_AND_CONFIGURATION"},
        "code": {"const": "IMPLEMENTATION"},
        "evidence": {"const": "TEST_AND_EVIDENCE"}
      }
    },
    "alignmentStates": {
      "type": "array",
      "items": {"enum": ["MATCH", "MAPPED", "MISSING", "EXTRA", "DRIFT", "CONFLICT", "DUPLICATE", "UNRESOLVED", "BLOCKED"]}
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noInference", "noSilentFeature", "noUnmappedPersistence", "noUnmappedApi", "noUnownedImplementation", "evidenceRequiredForGreen", "payloadOriginMustBeExplicit"],
      "properties": {
        "noInference": {"const": true},
        "noSilentFeature": {"const": true},
        "noUnmappedPersistence": {"const": true},
        "noUnmappedApi": {"const": true},
        "noUnownedImplementation": {"const": true},
        "evidenceRequiredForGreen": {"const": true},
        "payloadOriginMustBeExplicit": {"const": true}
      }
    }
  }
}
