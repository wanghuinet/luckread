{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/alignment/five-way-reconciliation.v1.schema.json",
  "title": "Luckread Five-Way Reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "sourceOfTruth", "records", "blockers", "inventoryStatus"],
  "properties": {
    "version": { "const": "1.0.0" },
    "status": { "enum": ["GREEN", "NOT_GREEN", "BLOCKED"] },
    "sourceOfTruth": { "const": "contracts/alignment/five-way-alignment.v1.json" },
    "generatedBy": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "status", "evidence", "blockers"],
        "properties": {
          "featureId": { "type": "string" },
          "status": { "enum": ["MATCH", "MAPPED", "MISSING", "EXTRA", "DRIFT", "CONFLICT", "DUPLICATE", "UNRESOLVED", "BLOCKED"] },
          "entityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "apiOperationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "payloadCollections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "codeEvidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inventoryStatus": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
