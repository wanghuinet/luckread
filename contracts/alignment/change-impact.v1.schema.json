{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"LuckRead Change Impact Contract v1",
  "type":"object",
  "required":["version","status","sourceOfTruth","records"],
  "properties":{
    "version":{"const":"1.0.0"},
    "status":{"enum":["NOT_GREEN","GREEN","BLOCKED"]},
    "sourceOfTruth":{"type":"string"},
    "records":{"type":"array","items":{"type":"object","required":["impactId","featureId","status","affectedSystems","evidenceRefs"],"properties":{"impactId":{"type":"string"},"featureId":{"type":"string"},"status":{"enum":["UNCHANGED","ADDED","REMOVED","MODIFIED","BLOCKED","UNRESOLVED"]},"affectedSystems":{"type":"array","items":{"enum":["DB","API","PAYLOAD","CODE","TEST","MIGRATION","EVENT","AUTHORIZATION"]}},"affectedRefs":{"type":"array","items":{"type":"string"}},"evidenceRefs":{"type":"array","items":{"type":"string"}},"blockers":{"type":"array","items":{"type":"string"}}}}}
  }
}
