{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/events/identity-account-state-changed.v1.json",
  "title": "Identity Account State Changed Event v1",
  "description": "Canonical durable event for an authoritative D1-01 account-state transition.",
  "type": "object",
  "properties": {
    "eventId": {
      "$ref": "../schemas/common/resource-id.json"
    },
    "eventType": {
      "const": "identity.account_state_changed"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "producer": {
      "const": "W02"
    },
    "resourceType": {
      "const": "User"
    },
    "resourceId": {
      "$ref": "../schemas/common/resource-id.json"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "causationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "idempotencyKey": {
      "$ref": "../schemas/common/idempotency-key.json"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "sourceVersion": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "$ref": "../schemas/common/actor.json"
    },
    "before": {
      "type": "object",
      "properties": {
        "accountState": {
          "$ref": "../enums/account-state.json"
        },
        "accountStateVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "accountState",
        "accountStateVersion"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "properties": {
        "accountState": {
          "$ref": "../enums/account-state.json"
        },
        "accountStateVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "accountState",
        "accountStateVersion"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "producer",
    "resourceType",
    "resourceId",
    "occurredAt",
    "publishedAt",
    "correlationId",
    "causationId",
    "idempotencyKey",
    "attempt",
    "sourceVersion",
    "actor",
    "before",
    "after",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "operationalRole": {
                "const": "PLATFORM_OPERATOR"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "actorType": {
                "const": "user"
              }
            }
          }
        }
      }
    }
  ],
  "x-luckread": {
    "canonical": true,
    "producer-authority": "W02",
    "authoritative-domain": "D1-01",
    "consumer-authority": "W06",
    "projection-consumer-authority": "W04",
    "delivery-topology": "W02_DIRECT_MULTI_DESTINATION",
    "delivery": "AT_LEAST_ONCE",
    "ordering": "PER_RESOURCE",
    "deduplication": [
      "eventId",
      "producer+idempotencyKey+resourceId"
    ],
    "destinations": {
      "audit": {
        "worker": "W06",
        "queue": "luckread-auth013-account-state",
        "dead-letter-queue": "luckread-auth013-account-state-dlq"
      },
      "projection": {
        "worker": "W04",
        "queue": "luckread-auth013-account-state-projection",
        "dead-letter-queue": "luckread-auth013-account-state-projection-dlq"
      }
    },
    "partial-delivery-rule": "The authoritative journal record remains pending until all required destinations accept the event. A retry may redeliver an already-accepted destination; each consumer MUST deduplicate by eventId (or the canonical composite key) and MUST NOT regress a newer per-resource version.",
    "target-authority": "W04-derived-projection-only",
    "journal-class": "D1-01_LOCAL_DURABLE_PUBLICATION_JOURNAL",
    "event-is-authority": false
  }
}
