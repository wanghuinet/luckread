{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/events/privacy-consent-withdrawn.v1.json",
  "title": "Privacy Consent Withdrawn Event",
  "version": "1.0.0",
  "status": "CONTRACTED_NOT_VERIFIED",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "consentId",
    "subjectId",
    "resourceId",
    "resourceType",
    "previousState",
    "newState",
    "policyVersion"
  ],
  "properties": {
    "eventId": {
      "$ref": "../schemas/common/resource-id.json"
    },
    "eventType": {
      "const": "privacy.consent_withdrawn"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "consentId": {
      "$ref": "../schemas/common/resource-id.json"
    },
    "subjectId": {
      "$ref": "../schemas/common/resource-id.json"
    },
    "resourceId": {
      "$ref": "../schemas/common/resource-id.json"
    },
    "resourceType": {
      "type": "string",
      "const": "User"
    },
    "previousState": {
      "type": "string",
      "enum": [
        "GRANTED",
        "RESTRICTED_PROCESSING"
      ]
    },
    "newState": {
      "const": "REVOKED"
    },
    "policyVersion": {
      "type": "string"
    },
    "legalHoldRef": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "rules": [
    "The event records the consent withdrawal fact but does not become business authority.",
    "Duplicate event delivery is controlled by eventId.",
    "Consumers must not recreate a revoked consent from older events.",
    "History remains immutable after withdrawal."
  ],
  "sourceRefs": [
    "docs/184-L5-L6-IDENTITY-AND-SESSION-INSTANCE-REGISTRY-v1.0.md",
    "docs/160-DATA-LIFECYCLE-RETENTION-ERASURE-CONTRACT-v1.0.md"
  ]
}
