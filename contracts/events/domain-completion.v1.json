{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/events/domain-completion.v1.json",
  "title": "Domain Completion Event Contract",
  "type": "object",
  "x-events": [
    {"name":"org.member.added","aggregate":"OrgMembership"},
    {"name":"org.member.removed","aggregate":"OrgMembership"},
    {"name":"org.member.role_changed","aggregate":"OrgMembership"},
    {"name":"ip.transferred","aggregate":"IP"},
    {"name":"ip.dissolved","aggregate":"IP"},
    {"name":"entitlement.granted","aggregate":"Entitlement"},
    {"name":"entitlement.revoked","aggregate":"Entitlement"},
    {"name":"media.processing.completed","aggregate":"Media"},
    {"name":"media.processing.failed","aggregate":"Media"},
    {"name":"moderation.case.decided","aggregate":"ModerationCase"},
    {"name":"moderation.case.appealed","aggregate":"ModerationCase"}
  ],
  "required": ["event_id","event_type","occurred_at","aggregate_type","aggregate_id","schema_version","actor_type","actor_id","payload"]
}
