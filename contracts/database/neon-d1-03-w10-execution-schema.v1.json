  "authority": {
    "rule": "W10 owns only async execution metadata. The original owner Worker retains every business-state mutation and authorization decision.",
    "execution": "A job is admitted only under an explicitly approved owner Worker, Task, operation and Workflow/Job contract.",
    "idempotency": "OperationalIdempotency covers W10 async-operation submission only. Domain-local idempotency remains in the source D1 and is not copied here.",
    "inbox": "ExecutionInbox records W10 consumer delivery identity and dedupe metadata only.",
    "outbox": "ExecutionOutbox records W10-owned execution events only. Producer-local business outboxes remain with their authoritative Worker.",
    "deadLetter": "D1-03 dead-letter metadata is a searchable quarantine/evidence record, not a replacement for the native Queue DLQ or its retry configuration."
  },
  "schema": {
    "tables": {
      "jobs": {
        "entity": "Job",
        "operationContract": "docs/165-UNIFIED-ASYNC-OPERATION-CONTRACT-v1.0.md",
        "columns": [
          "job_id",
          "operation_id",
          "operation_type",
          "owner_worker",
          "owner_task_id",
          "resource_type",
          "resource_id",
          "actor_id",
          "subject_id",
          "scope",
          "state",
          "progress_current",
          "progress_total",
          "created_at",
          "started_at",
          "updated_at",
          "completed_at",
          "expires_at",
          "idempotency_key",
          "correlation_id",
          "request_id",
          "trace_id",
          "error_code",
          "result_ref"
        ],
        "states": [
          "ACCEPTED",
          "QUEUED",
          "RUNNING",
          "SUCCEEDED",
          "FAILED",
          "CANCEL_REQUESTED",
          "STOPPING",
          "CANCELLED",
          "EXPIRED",
          "PARTIALLY_COMPLETED",
          "REQUIRES_ACTION",
          "UNKNOWN"
        ],
        "payloadRule": "No raw job payload, credential, payment data or private message is stored. Result data is referenced by an opaque result_ref."
      },
      "job_retries": {
        "entity": "Retry",
        "contract": "docs/163-EVENT-SEMANTICS-DELIVERY-ORDERING-REPLAY-DLQ-CONTRACT-v1.0.md",
        "columns": [
          "retry_id",
          "job_id",
          "attempt_number",
          "failure_class",
          "error_code",
          "error_summary",
          "scheduled_at",
          "started_at",
          "completed_at",
          "next_attempt_at",
          "created_at"
        ],
        "failureClasses": [
          "transient",
          "permanent",
          "poison"
        ],
        "sameOwnerForeignKeys": 1
      },
      "execution_dead_letters": {
        "entity": "DLQ",
        "contract": "docs/163-EVENT-SEMANTICS-DELIVERY-ORDERING-REPLAY-DLQ-CONTRACT-v1.0.md",
        "columns": [
          "dlq_id",
          "event_id",
          "consumer_name",
          "original_event_metadata_json",
          "payload_sha256",
          "attempt_count",
          "last_error_class",
          "last_error_summary",
          "first_seen_at",
          "last_seen_at",
          "resolution_status",
          "replay_id",
          "resolved_at"
        ],
        "metadataRule": "Only non-sensitive event metadata and a payload hash are stored; raw event payload is excluded.",
        "resolutionStates": [
          "OPEN",
          "REPLAYED",
          "DISCARDED"
        ]
      },
      "execution_inbox": {
        "entity": "ExecutionInbox",
        "contract": "docs/163-EVENT-SEMANTICS-DELIVERY-ORDERING-REPLAY-DLQ-CONTRACT-v1.0.md",
        "columns": [
          "consumer_name",
          "event_id",
          "event_type",
          "schema_version",
          "producer",
          "resource_type",
          "resource_id",
          "idempotency_key",
          "source_version",
          "correlation_id",
          "causation_id",
          "payload_sha256",
          "status",
          "received_at",
          "processed_at",
          "last_error_code"
        ],
        "states": [
          "RECEIVED",
          "PROCESSING",
          "APPLIED",
          "STALE",
          "REJECTED",
          "QUARANTINED"
        ]
      },
      "execution_outbox": {
        "entity": "ExecutionOutbox",
        "contract": "docs/163-EVENT-SEMANTICS-DELIVERY-ORDERING-REPLAY-DLQ-CONTRACT-v1.0.md",
        "columns": [
          "outbox_id",
          "event_id",
          "event_type",
          "schema_version",
          "producer",
          "resource_type",
          "resource_id",
          "occurred_at",
          "correlation_id",
          "causation_id",
          "idempotency_key",
          "source_version",
          "payload_ref",
          "payload_sha256",
          "status",
          "attempts",
          "next_attempt_at",
          "last_error",
          "created_at",
          "published_at"
        ],
        "payloadRule": "Only opaque payload references and hashes are persisted; raw payload remains with its owning domain or approved object storage."
      },
      "operational_idempotency": {
        "entity": "OperationalIdempotency",
        "contract": "docs/165-UNIFIED-ASYNC-OPERATION-CONTRACT-v1.0.md",
        "columns": [
          "idempotency_id",
          "owner_worker",
          "operation_type",
          "scope",
          "idempotency_key",
          "request_hash",
          "operation_id",
          "created_at",
          "expires_at"
        ],
        "scopeRule": "Unique by owner Worker, operation type, scope and idempotency key. This table cannot replace source-domain idempotency."
      }
