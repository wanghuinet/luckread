  "postgresMappings": {
    "integer": "Use BIGINT for D1/SQLite INTEGER fields to preserve the signed 64-bit source range; retain safe-integer checks for money and version counters.",
    "time": "Map ISO-8601 TEXT instant fields to TIMESTAMPTZ and compare as instants; no local timezone assumptions.",
    "json": "Keep JSON text snapshots as TEXT with PostgreSQL JSONB type checks where the source requires JSON validity/object shape. Keep response_json as TEXT with validity check.",
    "partialUnique": "Preserve ux_payments_single_live_or_successful_per_order as a PostgreSQL partial unique index.",
    "relationships": "Preserve source trigger-enforced logical relations. Do not add foreign keys; the source regression suite explicitly requires zero FKs for D1-04 finance tables.",
    "triggerSemantics": "Preserve source immutable snapshots, CAS/version guards, allowed order transitions, payable-order binding, idempotency pairing, webhook receipt immutability, conflict first-receipt binding and retention.",
    "renewalCycles": "Preserve immutable billing-cycle identity and resolved pricing snapshots, the W07-owned cycle state machine, CAS leases, exact Order/Payment binding, active MIT mandate check, terminal provider-outcome synchronization and one scheduler control-metadata singleton. W10 orchestrates but never reads or writes D1-04; subscription entitlements remain D1-01 authority."
  },
