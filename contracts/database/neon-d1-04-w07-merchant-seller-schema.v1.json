          "merchant_type",
          "identity_ref",
          "created_at"
        ],
        "status": [
          "PENDING",
          "ACTIVE",
          "RESTRICTED",
          "SUSPENDED",
          "CLOSED"
        ]
      },
      "merchant_stores": {
        "primaryKey": "store_id",
        "owner": "merchant_id",
        "ownerImmutable": true,
        "status": [
          "OPEN",
          "PAUSED",
          "CLOSED"
        ]
      },
      "merchant_qualifications": {
        "primaryKey": "qualification_id",
        "unique": [
          "merchant_id",
          "capability",
          "jurisdiction_country",
          "jurisdiction_region"
        ],
        "status": [
          "PENDING_REVIEW",
          "APPROVED",
          "DENIED",
          "EXPIRED",
          "RE_REVIEW"
        ]
      },
      "merchant_staff": {
        "primaryKey": "staff_id",
        "identityReference": "W02 user_id; no copied identity data",
        "activeMembershipUnique": [
          "merchant_id",
          "user_id"
        ],
        "status": [
          "INVITED",
          "ACTIVE",
          "SUSPENDED",
          "REMOVED"
        ]
      },
      "merchant_scopes": {
        "primaryKey": "scope_id",
        "denyByDefault": true,
        "explicitResourceScope": true,
        "settlementView": "READ_ONLY",
        "status": [
          "ACTIVE",
          "REVOKED"
        ]
      }
    },
    "explicitIndexNames": [
