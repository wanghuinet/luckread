{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/api/revision.json",
  "title": "LuckRead Content Revision API Contract",
  "version": "1.0.0",
  "domain": "content",
  "purpose": "Production contract for draft revision listing, retrieval and rollback. Revision history is immutable; rollback creates a new revision rather than rewriting history.",
  "invariants": [
    "actorId MUST be derived from the authenticated server-side principal.",
    "A revision is immutable after creation; no PATCH or DELETE operation may mutate historical revision contents.",
    "Only authorized owners or scoped editors may read private revisions or create rollback operations.",
    "Rollback MUST create a new authoritative content version/revision and MUST NOT delete the source revision.",
    "Rollback MUST use If-Match against the current content ETag and MUST fail closed on stale state.",
    "Revision creation and rollback MUST be idempotent where a client retry can be identified by Idempotency-Key.",
    "Revision history MUST preserve actor, source revision, resulting revision, content version and correlation identifiers.",
    "Private draft/revision data MUST NOT be served from shared caches.",
    "Deleting a content object MUST follow the canonical deletion/erasure contract; revision retention MUST follow the content lifecycle policy."
  ],
  "operations": [
    {
      "operationId": "listContentRevisions",
      "method": "GET",
      "path": "/contents/{contentId}/revisions",
      "auth": { "required": true, "permission": "content.revision.read", "scope": "content" },
      "request": {
        "path": { "contentId": { "$ref": "#/definitions/ResourceId" } },
        "query": { "cursor": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } }
      },
      "success": { "status": 200, "pagination": "opaque_cursor" },
      "errors": ["AUTH_REQUIRED", "PERMISSION_DENIED", "RESOURCE_NOT_FOUND"]
    },
    {
      "operationId": "getContentRevision",
      "method": "GET",
      "path": "/contents/{contentId}/revisions/{revisionId}",
      "auth": { "required": true, "permission": "content.revision.read", "scope": "content" },
      "request": {
        "path": {
          "contentId": { "$ref": "#/definitions/ResourceId" },
          "revisionId": { "$ref": "#/definitions/ResourceId" }
        }
      },
      "success": { "status": 200 },
      "errors": ["AUTH_REQUIRED", "PERMISSION_DENIED", "RESOURCE_NOT_FOUND"]
    },
    {
      "operationId": "rollbackContentRevision",
      "method": "POST",
      "path": "/contents/{contentId}/revisions/{revisionId}/rollback",
      "auth": { "required": true, "permission": "content.revision.rollback", "scope": "content" },
      "request": {
        "path": {
          "contentId": { "$ref": "#/definitions/ResourceId" },
          "revisionId": { "$ref": "#/definitions/ResourceId" }
        },
        "headers": { "If-Match": { "$ref": "#/definitions/ETag" }, "Idempotency-Key": { "type": "string", "maxLength": 256 } },
        "body": { "reason": { "type": "string", "maxLength": 2048 } }
      },
      "success": { "status": 200, "createsNewRevision": true },
      "errors": ["AUTH_REQUIRED", "PERMISSION_DENIED", "RESOURCE_NOT_FOUND", "PRECONDITION_REQUIRED", "PRECONDITION_FAILED", "INVALID_STATE", "CONFLICT"],
      "concurrency": { "strategy": "ETAG_COMPARE_AND_SWAP", "staleResult": "PRECONDITION_FAILED" },
      "cache": { "mode": "PRIVATE_INVALIDATE_OR_VERSION_BUMP", "shared": false },
      "events": { "asyncMax": 2, "fanoutMax": 0, "event": "content.revision.rolled_back" },
      "audit": { "required": true, "record": "actor, sourceRevision, resultingRevision, contentVersion, reason, correlationId" }
    }
  ],
  "definitions": {
    "ResourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ETag": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "greenEvidence": {
    "openapi": "required",
    "permission": "required",
    "etag": "required",
    "idempotency": "required",
    "immutability": "required",
    "integration": "required"
  }
}
