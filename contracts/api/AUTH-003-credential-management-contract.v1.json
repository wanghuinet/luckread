{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/api/auth-003-credential-management.json",
  "version":"1.0.0",
  "status":"CONTRACTED_NOT_VERIFIED",
  "featureId":"AUTH-003",
  "operations":[
    {"operationId":"authCredentialList","method":"GET","path":"/auth/credentials","visibility":"public_authenticated","authorization":{"required":true,"permission":"user.credential.read","scope":"self"}},
    {"operationId":"authCredentialAdd","method":"POST","path":"/auth/credentials","visibility":"public_authenticated","authorization":{"required":true,"permission":"user.credential.manage","scope":"self"},"idempotency":{"required":true,"key":"Idempotency-Key"}},
    {"operationId":"authCredentialReplace","method":"PUT","path":"/auth/credentials/{credentialId}","visibility":"public_authenticated","authorization":{"required":true,"permission":"user.credential.manage","scope":"self"},"idempotency":{"required":true,"key":"Idempotency-Key"}},
    {"operationId":"authCredentialRemove","method":"DELETE","path":"/auth/credentials/{credentialId}","visibility":"public_authenticated","authorization":{"required":true,"permission":"user.credential.manage","scope":"self"},"idempotency":{"required":true,"key":"Idempotency-Key"}}
  ],
  "dtoIds":{
    "listResponse":"DTO-AUTH-003-CREDENTIAL-LIST-RESPONSE",
    "addRequest":"DTO-AUTH-003-CREDENTIAL-ADD-REQUEST",
    "addResponse":"DTO-AUTH-003-CREDENTIAL-ADD-RESPONSE",
    "replaceRequest":"DTO-AUTH-003-CREDENTIAL-REPLACE-REQUEST",
    "replaceResponse":"DTO-AUTH-003-CREDENTIAL-REPLACE-RESPONSE",
    "removeResponse":"DTO-AUTH-003-CREDENTIAL-REMOVE-RESPONSE"
  },
  "entityIds":["ENT-IDENTITY","ENT-CREDENTIAL"],
  "normalization":[
    {"kind":"username","algorithm":"trim_then_unicode_nfc_then_casefold","preserveOriginalForDisplay":true,"canonicalLookupField":"ENT-CREDENTIAL-F-NORMALIZED-VALUE"},
    {"kind":"email","algorithm":"trim_then_unicode_nfc_then_casefold","providerSpecificTransformations":"FORBIDDEN_UNLESS_EXPLICITLY_CONTRACTED","canonicalLookupField":"ENT-CREDENTIAL-F-NORMALIZED-VALUE"},
    {"kind":"phone","algorithm":"parse_and_validate_as_E164","canonicalLookupField":"ENT-CREDENTIAL-F-NORMALIZED-VALUE"}
  ],
  "uniqueness":{
    "authority":"persistence_boundary",
    "scope":["kind","normalizedValue"],
    "raceHandling":"concurrent_insert_must_resolve_to_single_authoritative_owner",
    "conflictDisclosure":"generic_credential_conflict_response; never disclose protected account existence"
  },
  "lifecycle":{
    "states":["ACTIVE","INACTIVE","RETIRED"],
    "add":"ACTIVE unless verification is required by the credential kind and account policy",
    "replace":"new canonical value becomes authoritative only after successful validation and required verification",
    "remove":"mark inactive/retired according to account safety policy; do not orphan the account's only login method without an explicit recovery-safe path"
  },
  "securityInvariants":[
    "credential_values_never_appear_in_logs",
    "credential_values_never_appear_in_public_api_projections",
    "normalized_values_never_appear_in_public_api_projections",
    "credential_hashes_never_appear_in_public_api_projections",
    "cross_account_credential_management_is_denied",
    "error_semantics_do_not_confirm_protected_account_existence",
    "authorization_is_evaluated_before_mutation",
    "uniqueness_is_enforced_under_concurrency"
  ],
  "wireContract":{
    "publicResource":{
      "credentialId":{"type":"string","minLength":1,"maxLength":128,"opaque":true,"directInternalIdExposure":false}
    },
    "publicProjection":{
      "credentialId":{"type":"string","minLength":1,"maxLength":128},
      "kind":{"type":"string","enum":["username","email","phone"]},
      "active":{"type":"boolean"}
    },
    "addRequest":{
      "required":["kind","value"],
      "properties":{
        "kind":{"type":"string","enum":["username","email","phone"]},
        "value":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "replaceRequest":{
      "required":["value"],
      "properties":{
        "value":{"type":"string","minLength":1}
      },
      "additionalProperties":false,
      "kindChange":"FORBIDDEN"
    },
    "list":{
      "query":["cursor","limit"],
      "defaultLimit":50,
      "maxLimit":100,
      "pagination":"canonical_cursor",
      "ordering":"createdAt DESC, credentialId DESC",
      "responseEnvelope":"contracts/schemas/common/list-response.json",
      "emptyResultStatus":200
    },
    "successStatus":{"list":200,"add":201,"replace":200,"remove":204},
    "errors":{
      "unauthenticated":401,
      "permissionDenied":403,
      "notFound":404,
      "conflict":409,
      "validation":422,
      "rateLimited":429,
      "credentialConflictMustNotDiscloseExistence":true,
      "errorEnvelope":"contracts/schemas/common/error-response.json"
    },
    "idempotencyRequired":["authCredentialAdd","authCredentialReplace","authCredentialRemove"]
  },
  "evidenceStatus":{
    "api":"CONTRACTED_NOT_VERIFIED",
    "dto":"CONTRACTED_NOT_VERIFIED",
    "entity":"CONTRACTED_NOT_VERIFIED",
    "field":"CONTRACTED_NOT_VERIFIED",
    "persistence":"MISSING",
    "runtime":"MISSING",
    "integration":"MISSING",
    "securityE2E":"MISSING",
    "mapping0":"MISSING"
  },
  "sourceRefs":[
    "contracts/alignment/mapping-batches/AUTH-003-real-evidence-reconciliation.v1.md",
    "contracts/entity/AUTH-003-credential-field-contract.v1.json",
    "contracts/api/auth-operation-policy.v1.json",
    "contracts/entity/entity-catalog.v1.json",
    "contracts/entity/entity-field-contract.v1.json"
  ]
}
