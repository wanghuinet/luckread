{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0",
  "status": "PHASE_1_IMPLEMENTATION_CONTRACT",
  "operations": [
    {
      "method": "GET",
      "path": "/v1/conversations",
      "operationId": "listMessagingConversations",
      "auth": "required",
      "query": [
        "cursor",
        "limit"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/conversations",
      "operationId": "createMessagingConversation",
      "auth": "required",
      "body": [
        "recipientUserId"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/conversations/{conversationId}/messages",
      "operationId": "listMessagingMessages",
      "auth": "required",
      "query": [
        "beforeSequence",
        "afterSequence",
        "limit"
      ],
      "cursorPolicy": "beforeSequence_and_afterSequence_are_mutually_exclusive"
    },
    {
      "method": "POST",
      "path": "/v1/conversations/{conversationId}/messages",
      "operationId": "sendMessagingMessage",
      "auth": "required",
      "headers": [
        "Idempotency-Key"
      ],
      "body": [
        "body"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/conversations/{conversationId}/read",
      "operationId": "markMessagingConversationRead",
      "auth": "required",
      "body": [
        "sequence"
      ]
    }
  ],
  "limits": {
    "pageSizeMax": 50,
    "messageBodyMaxLength": 10000,
    "idempotencyKeyMaxLength": 128,
    "messageSequenceMaxDigits": 18
  },
  "responsePolicy": "no-store",
  "phase1NonGoals": [
    "group messaging",
    "attachments",
    "presence",
    "typing",
    "websocket",
    "push delivery",
    "message requests"
  ],
  "admissionPolicy": {
    "newConversation": "MUTUAL_FOLLOWERS_ONLY",
    "nonMutualAdmission": "DENY_WITH_403_CONTACT_POLICY_DENIED",
    "messageRequests": "NOT_SUPPORTED_IN_PHASE_1",
    "blockPolicy": "BIDIRECTIONAL_BLOCK_DENIES_CREATE_INBOX_HISTORY_SEND_AND_READ"
  }
}
