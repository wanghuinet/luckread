    {
      "operationId":"refreshFeedProjection",
      "method":"POST",
      "path":"/internal/feed/projections/refresh",
      "visibility":"internal_service",
      "capability":"feed_projection_refresh",
      "status":"MISSING",
      "authorization":{"required":true,"permission":"platform.feed_projection.write","scope":"service_identity"},
      "resource":{"class":"ASYNC_PROJECTION","d1ReadMax":1,"d1WriteMax":1,"d1ReadRowsMax":500,"d1WriteRowsMax":200,"rpcMax":1,"candidateItemsMax":5000},
      "cache":{"mode":"TARGETED_INVALIDATION_OR_VERSION_BUMP","public":false},
      "retry":{"maxAttempts":3,"clientRetrySafe":true,"backoff":"bounded_exponential"},
      "event":{"syncConsumersMax":0,"asyncEventsMax":1,"fanoutMax":0},
      "queue":{"enqueueMax":1,"depthBounded":true,"dlqRequired":true},
      "antiAbuse":{"required":true,"scopes":["service","endpoint","global"],"actions":["ALLOW","THROTTLE","BLOCK"]},
      "ranking":{"mode":"ASYNC_PRECOMPUTE","candidateMax":5000,"rankedResultMax":500,"perItemRpc":false},
      "idempotency":{"required":true,"key":"projectionVersion"},
      "security":["service_identity","no_client_access","bounded_batch","replay_safe"],
      "evidence":{"openapi":"MISSING","permission":"MISSING","state":"MISSING","resource":"MISSING","cache":"MISSING","antiAbuse":"MISSING","integration":"MISSING","securityE2E":"MISSING"}
    }
