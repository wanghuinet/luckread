      "pagination":{"style":"OPAQUE_CURSOR","pageSizeMax":50,"stableSortRequired":true},
      "cache":{"mode":"EDGE_CACHE","public":true,"ttlSecondsMax":30,"staleWhileRevalidateSeconds":180,"singleFlight":true,"ttlJitterRequired":true},
      "retry":{"maxAttempts":1,"clientRetrySafe":true},
      "event":{"syncConsumersMax":0,"asyncEventsMax":0,"fanoutMax":0},
      "queue":{"enqueueMax":0},
      "antiAbuse":{"required":true,"scopes":["ip","device","endpoint","global"],"actions":["ALLOW","THROTTLE","BLOCK"]},
      "ranking":{"mode":"PRECOMPUTED_ASYNC","candidateMax":500,"rankedResultMax":50,"perItemRpc":false},
      "eligibility":["published_state","moderation_state","visibility_policy","regional_policy"],
      "idempotency":{"required":false},
      "security":["public_projection_only","no_private_fields","bounded_payload"],
