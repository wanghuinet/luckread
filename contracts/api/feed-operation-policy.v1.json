      "eligibility":["follow_relation","published_state","block_mute_policy","visibility_policy","account_state"],
      "idempotency":{"required":false},
      "security":["user_scoped_cache_key","tenant_scope","relationship_authority_server_side"],
      "evidence":{"openapi":"MISSING","permission":"MISSING","state":"MISSING","resource":"MISSING","cache":"MISSING","antiAbuse":"MISSING","integration":"MISSING","securityE2E":"MISSING"}
    },
