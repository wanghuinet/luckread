{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/api/feed-operation-policy.json",
  "title":"LuckRead Feed API Operation Policy",
  "version":"1.0.0",
  "domain":"feed",
  "greenRule":"Feed is production-green only when candidate, eligibility, ranking, pagination, cache, anti-abuse, resource budgets and runtime E2E evidence all pass.",
  "invariants":[
    "Feed reads MUST be bounded; no unbounded candidate, fan-out or ranking operation is permitted.",
    "Opaque cursor pagination MUST be used for infinite feeds; offset pagination is forbidden for recommendation and high-volume feeds.",
    "Normal public feed reads SHOULD be D1=0 through Edge Cache; cache miss rebuild MUST have a bounded D1 read budget.",
    "A cache key MUST include every dimension that changes authorization or representation; private data MUST NOT enter shared public cache.",
    "Single Flight MUST coalesce concurrent cache misses for the same normalized key.",
    "Recommendation, follow, block, mute and visibility eligibility MUST be enforced before final result emission.",
    "Ranking MUST operate on a bounded candidate set and bounded feature payload; no per-item unbounded RPC or D1 query is allowed.",
    "Feed generation MUST degrade gracefully: stale public cache is preferable to unbounded synchronous database work.",
    "Client-provided ranking, ownership, visibility or eligibility fields MUST never be trusted.",
    "Feed projection writes are asynchronous and bounded; a feed request MUST NOT synchronously update counters, analytics, notifications or search indexes."
  ],
  "operations":[
    {
      "operationId":"getHomeFeed",
      "method":"GET",
      "path":"/feed/home",
      "visibility":"public_or_authenticated",
      "capability":"home_feed",
      "status":"CONTRACTED_PARTIAL",
      "authorization":{"required":false,"permission":"feed.read","scope":"representation_and_policy"},
      "resource":{"class":"CACHE_FIRST_BOUNDED_READ","d1ReadMax":1,"d1WriteMax":0,"d1ReadRowsMax":200,"d1WriteRowsMax":0,"rpcMax":2,"responseItemsMax":50,"candidateItemsMax":500,"cpuMsBudget":50},
      "pagination":{"style":"OPAQUE_CURSOR","pageSizeMax":50,"cursorTtlSeconds":86400,"stableSortRequired":true},
      "cache":{"mode":"EDGE_CACHE","public":true,"ttlSecondsMax":60,"staleWhileRevalidateSeconds":300,"singleFlight":true,"negativeCacheSecondsMax":10,"ttlJitterRequired":true},
      "retry":{"maxAttempts":1,"clientRetrySafe":true},
      "event":{"syncConsumersMax":0,"asyncEventsMax":0,"fanoutMax":0},
      "queue":{"enqueueMax":0},
      "antiAbuse":{"required":true,"scopes":["ip","device","account","endpoint","global"],"actions":["ALLOW","THROTTLE","CHALLENGE","BLOCK"]},
      "ranking":{"mode":"POLICY_SELECTED","candidateMax":500,"rankedResultMax":50,"featureBytesMax":65536,"perItemRpc":false},
      "eligibility":["content_published","content_not_deleted","audience_policy","region_policy","age_policy","account_state","block_mute_policy"],
      "idempotency":{"required":false},
      "security":["server_owned_user_context","no_client_rank_override","no_private_data_in_shared_cache"],
      "evidence":{"openapi":"PASS","permission":"PASS","state":"PASS","resource":"MISSING","cache":"MISSING","antiAbuse":"MISSING","integration":"MISSING","securityE2E":"MISSING"}
    },
