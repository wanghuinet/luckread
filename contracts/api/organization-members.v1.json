{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/api/organization-members.json",
  "title":"Organization Members API Contract",
  "version":"1.0.0",
  "operations":[
    {"operationId":"listOrganizationMembers","method":"GET","path":"/organizations/{organizationId}/members","auth":{"required":true,"permission":"organization.member.read","scope":"organization"},"success":{"status":200,"pagination":"opaque_cursor"},"errors":["AUTH_REQUIRED","PERMISSION_DENIED","RESOURCE_NOT_FOUND","VALIDATION_FAILED"]},
    {"operationId":"inviteOrganizationMember","method":"POST","path":"/organizations/{organizationId}/members/invitations","auth":{"required":true,"permission":"organization.member.manage","scope":"organization"},"request":{"headers":{"Idempotency-Key":{"type":"string","maxLength":256}}},"success":{"status":201,"idempotent":true},"errors":["AUTH_REQUIRED","PERMISSION_DENIED","RESOURCE_NOT_FOUND","VALIDATION_FAILED","RATE_LIMITED","CONFLICT"]},
    {"operationId":"removeOrganizationMember","method":"DELETE","path":"/organizations/{organizationId}/members/{memberId}","auth":{"required":true,"permission":"organization.member.manage","scope":"organization"},"request":{"headers":{"If-Match":{"type":"string","minLength":1,"maxLength":256}}},"success":{"status":204,"idempotent":true},"errors":["AUTH_REQUIRED","PERMISSION_DENIED","RESOURCE_NOT_FOUND","PRECONDITION_REQUIRED","PRECONDITION_FAILED","CONFLICT"],"concurrency":{"strategy":"ETAG_COMPARE_AND_SWAP"}},
    {"operationId":"changeOrganizationMemberRole","method":"POST","path":"/organizations/{organizationId}/members/{memberId}/role","auth":{"required":true,"permission":"organization.role.manage","scope":"organization"},"request":{"headers":{"If-Match":{"type":"string","minLength":1,"maxLength":256}}},"success":{"status":200,"idempotent":true},"errors":["AUTH_REQUIRED","PERMISSION_DENIED","RESOURCE_NOT_FOUND","VALIDATION_FAILED","PRECONDITION_REQUIRED","PRECONDITION_FAILED","CONFLICT"],"concurrency":{"strategy":"ETAG_COMPARE_AND_SWAP"}}
  ],
  "invariants":["organization membership is distinct from global user identity","role is distinct from entitlement","all mutations emit auditable organization membership events","server owns organizationId/memberId/actorId/timestamps","authorization is evaluated against current organization membership state"],
  "greenEvidence":{"openapi":"required","tenantIsolation":"required","authorization":"required","idempotency":"required","optimisticLock":"required","audit":"required","securityE2E":"required"},
  "status":"CONTRACT_COMPLETE_IMPLEMENTATION_PENDING"
}