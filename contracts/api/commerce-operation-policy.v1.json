{
  "version": "1.0.0",
  "domain": "subscription_entitlement_payment",
  "source": "LuckRead W07 commerce customer billing and refund contracts",
  "operations": [
    {
      "operationId": "postPaymentsRefunds",
      "method": "POST",
      "path": "/payments/refunds",
      "visibility": "public_authenticated",
      "capability": "customer_payment_refund",
      "status": "CONTRACTED_PARTIAL",
      "authorization": { "required": true, "permission": "payment.refund", "scope": "self" },
      "resource": { "class": "PROVIDER_BACKED_SINGLE_WRITE", "d1ReadMax": 4, "d1WriteMax": 2, "d1ReadRowsMax": 4, "d1WriteRowsMax": 2, "rpcMax": 2 },
      "cache": { "mode": "NO_STORE", "shared": false, "authorizationBoundary": true },
      "retry": { "maxAttempts": 1, "clientRetrySafe": true, "requiresOptimisticConcurrency": false },
      "event": { "syncConsumersMax": 0, "asyncEventsMax": 0, "fanoutMax": 0 },
      "queue": { "enqueueMax": 0 },
      "antiAbuse": { "required": true, "scopes": ["account", "payment", "endpoint", "global"], "actions": ["ALLOW", "THROTTLE", "BLOCK"] },
      "idempotency": { "required": true, "key": "Idempotency-Key", "semantic": "same customer and semantic refund request reuses the same stable Hyperswitch refund_id; mismatched key reuse conflicts" },
      "security": ["own_payment_only", "provider_captured_amount_is_authoritative", "no_client_supplied_merchant_or_captured_amount", "signed_webhook_only_finalizes_refund", "no_entitlement_mutation"]
    },
    {
      "operationId": "getPaymentsHistory",
      "method": "GET",
      "path": "/payments/history",
      "visibility": "public_authenticated",
      "capability": "customer_payment_history_read",
      "status": "CONTRACTED_PARTIAL",
      "authorization": { "required": true, "permission": "payment.read", "scope": "self" },
      "resource": { "class": "BOUNDED_KEYSET_READ", "d1ReadMax": 1, "d1WriteMax": 0, "d1ReadRowsMax": 51, "d1WriteRowsMax": 0, "rpcMax": 0 },
      "cache": { "mode": "PRIVATE_NO_STORE", "shared": false, "authorizationBoundary": true },
      "retry": { "maxAttempts": 1, "clientRetrySafe": true },
      "event": { "syncConsumersMax": 0, "asyncEventsMax": 0, "fanoutMax": 0 },
      "queue": { "enqueueMax": 0 },
      "antiAbuse": { "required": true, "scopes": ["account", "endpoint", "global"], "actions": ["ALLOW", "THROTTLE", "BLOCK"] },
      "idempotency": { "required": false },
      "security": ["customer_id_from_session_only", "merchant_and_provider_credentials_excluded", "bounded_keyset_pagination"]
    },
    {
      "operationId": "getPaymentsRefunds",
      "method": "GET",
      "path": "/payments/refunds",
      "visibility": "public_authenticated",
      "capability": "customer_refund_history_read",
      "status": "CONTRACTED_PARTIAL",
      "authorization": { "required": true, "permission": "payment.read", "scope": "self" },
      "resource": { "class": "BOUNDED_KEYSET_READ", "d1ReadMax": 1, "d1WriteMax": 0, "d1ReadRowsMax": 51, "d1WriteRowsMax": 0, "rpcMax": 0 },
      "cache": { "mode": "PRIVATE_NO_STORE", "shared": false, "authorizationBoundary": true },
      "retry": { "maxAttempts": 1, "clientRetrySafe": true },
      "event": { "syncConsumersMax": 0, "asyncEventsMax": 0, "fanoutMax": 0 },
      "queue": { "enqueueMax": 0 },
      "antiAbuse": { "required": true, "scopes": ["account", "endpoint", "global"], "actions": ["ALLOW", "THROTTLE", "BLOCK"] },
      "idempotency": { "required": false },
      "security": ["customer_id_from_session_only", "immutable_financial_facts", "bounded_keyset_pagination"]
    },
    {
      "operationId": "getBillingDocuments",
      "method": "GET",
      "path": "/billing/documents",
      "visibility": "public_authenticated",
      "capability": "customer_billing_document_read",
      "status": "CONTRACTED_PARTIAL",
      "authorization": { "required": true, "permission": "payment.read", "scope": "self" },
      "resource": { "class": "BOUNDED_KEYSET_READ", "d1ReadMax": 1, "d1WriteMax": 0, "d1ReadRowsMax": 51, "d1WriteRowsMax": 0, "rpcMax": 0 },
      "cache": { "mode": "PRIVATE_NO_STORE", "shared": false, "authorizationBoundary": true },
      "retry": { "maxAttempts": 1, "clientRetrySafe": true },
      "event": { "syncConsumersMax": 0, "asyncEventsMax": 0, "fanoutMax": 0 },
      "queue": { "enqueueMax": 0 },
      "antiAbuse": { "required": true, "scopes": ["account", "endpoint", "global"], "actions": ["ALLOW", "THROTTLE", "BLOCK"] },
      "idempotency": { "required": false },
      "security": ["customer_id_from_session_only", "issued_document_snapshots_immutable", "no_card_or_provider_secret", "bounded_keyset_pagination"]
    }
  ]
}
