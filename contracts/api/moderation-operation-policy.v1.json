      "security": { "required": true },
      "evidence": { "openapi": "PASS", "permission": "MISSING", "state": "N/A", "resource": "MISSING", "cache": "MISSING", "antiAbuse": "MISSING", "integration": "MISSING", "securityE2E": "MISSING" }
    },
    {
