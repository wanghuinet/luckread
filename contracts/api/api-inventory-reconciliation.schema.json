{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/api/api-inventory-reconciliation.schema.json",
  "title": "LuckRead Staged API Inventory Reconciliation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "stage",
    "status",
    "reconciliationGreen",
    "contractStatus",
    "productionReadinessStatus",
    "inventoryCount",
    "openapiOperationCount",
    "openapiPolicyCount",
    "failureCount",
    "findingCount",
    "productionEvidenceFindingCount",
    "failures",
    "findings",
    "productionEvidenceFindings",
    "informationalFindings",
    "rule"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.3.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "INCOMPLETE",
        "CONFLICT"
      ]
    },
    "reconciliationGreen": {
      "type": "boolean"
    },
    "inventoryCount": {
      "type": "integer",
      "minimum": 0
    },
    "openapiPolicyCount": {
      "type": "integer",
      "minimum": 0
    },
    "failureCount": {
      "type": "integer",
      "minimum": 0
    },
    "findingCount": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "operationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "inventory",
          "openapi"
        ],
        "properties": {
          "operationId": {
            "type": "string"
          },
          "inventory": {
            "type": "object",
            "required": [
              "method",
              "path"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "openapi": {
            "type": "object",
            "required": [
              "method",
              "path"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "CONTRACT",
        "PRODUCTION"
      ]
    },
    "contractStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "INCOMPLETE",
        "CONFLICT"
      ]
    },
    "productionReadinessStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "INCOMPLETE",
        "CONFLICT"
      ]
    },
    "openapiOperationCount": {
      "type": "integer",
      "minimum": 0
    },
    "productionEvidenceFindingCount": {
      "type": "integer",
      "minimum": 0
    },
    "productionEvidenceFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "operationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "informationalFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "operationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "policyGapSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreDetailedPolicyDomainCount",
        "alternatePolicyNormalizationGapCount",
        "normalizedPolicySourceCount",
        "coreDetailedPolicyMissingCount"
      ],
      "properties": {
        "coreDetailedPolicyDomainCount": {
          "type": "integer",
          "minimum": 0
        },
        "alternatePolicyNormalizationGapCount": {
          "type": "integer",
          "minimum": 0
        },
        "normalizedPolicySourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "coreDetailedPolicyMissingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "alternatePolicySources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "sources"
        ],
        "properties": {
          "operationId": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidenceSemantics": {
      "type": "object",
      "required": [
        "pass",
        "incomplete",
        "invalid"
      ],
      "properties": {
        "pass": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incomplete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "reconciliationGreen": {
            "const": true
          },
          "failureCount": {
            "const": 0
          },
          "findingCount": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliationGreen": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      }
    }
  ]
}
