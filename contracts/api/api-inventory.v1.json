    "schema",
    "openapi",
    "permission",
    "scope",
    "state_machine",
    "cache_policy",
    "read_write_classification",
    "resource_budget",
    "rpc_budget",
    "retry_budget",
    "event_budget",
    "queue_budget",
    "anti_abuse",
    "idempotency",
    "mapping",
    "examples",
    "integration_e2e"
