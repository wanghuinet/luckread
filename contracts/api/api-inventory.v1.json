{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "1.0",
  "status": "ARCHITECTURE_LOCKED_IMPLEMENTATION_PENDING",
  "purpose": "Machine-readable inventory proving public API coverage and endpoint-level contract completeness.",
  "green_rule": "An endpoint cannot be Contract Green unless every required evidence dimension is explicitly mapped and validated.",
  "required_evidence": [
    "schema",
    "openapi",
    "permission",
    "scope",
    "state_machine",
    "cache_policy",
    "read_write_classification",
    "resource_budget",
    "rpc_budget",
    "retry_budget",
    "event_budget",
    "queue_budget",
    "anti_abuse",
    "idempotency",
    "mapping",
    "examples",
    "integration_e2e"
  ],
  "endpoint_status": ["DRAFT", "CONTRACTED", "IMPLEMENTED", "INTEGRATED", "STABLE", "DEPRECATED", "REMOVED"],
  "domains": {
    "auth_identity": {
      "required": true,
      "endpoint_groups": [
        "POST /v1/auth/register",
        "POST /v1/auth/login",
        "POST /v1/auth/logout",
        "POST /v1/auth/refresh",
        "POST /v1/auth/revoke",
        "GET /v1/me",
        "PATCH /v1/me",
        "POST /v1/account/recovery",
        "POST /v1/account/password/change",
        "GET /v1/account/sessions",
        "DELETE /v1/account/sessions/{sessionId}"
      ]
    },
    "users_accounts": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/users/{userId}",
        "PATCH /v1/users/{userId}",
        "GET /v1/users/{userId}/profile",
        "GET /v1/users/{userId}/followers",
        "GET /v1/users/{userId}/following",
        "GET /v1/accounts/{accountId}",
        "PATCH /v1/accounts/{accountId}",
        "POST /v1/accounts/{accountId}/suspend",
        "POST /v1/accounts/{accountId}/restore"
      ]
    },
    "content": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/content/{contentId}",
        "POST /v1/content",
        "PATCH /v1/content/{contentId}",
        "DELETE /v1/content/{contentId}",
        "POST /v1/content/{contentId}/publish",
        "POST /v1/content/{contentId}/unpublish",
        "GET /v1/articles/{articleId}",
        "POST /v1/articles",
        "PATCH /v1/articles/{articleId}",
        "GET /v1/posts/{postId}",
        "POST /v1/posts",
        "PATCH /v1/posts/{postId}",
        "GET /v1/galleries/{galleryId}",
        "POST /v1/galleries",
        "PATCH /v1/galleries/{galleryId}"
      ]
    },
    "media": {
      "required": true,
      "endpoint_groups": [
        "POST /v1/media/uploads",
        "POST /v1/media/uploads/{uploadId}/complete",
        "GET /v1/media/{mediaId}",
        "DELETE /v1/media/{mediaId}",
        "POST /v1/media/{mediaId}/process",
        "GET /v1/media/{mediaId}/processing",
        "GET /v1/media/{mediaId}/playback",
        "GET /v1/media/{mediaId}/variants"
      ]
    },
    "feed": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/feed",
        "GET /v1/feed/following",
        "GET /v1/feed/recommended",
        "GET /v1/feed/user/{userId}",
        "GET /v1/content/{contentId}/related"
      ]
    },
    "interaction": {
      "required": true,
      "endpoint_groups": [
        "POST /v1/content/{contentId}/likes",
        "DELETE /v1/content/{contentId}/likes",
        "POST /v1/content/{contentId}/favorites",
        "DELETE /v1/content/{contentId}/favorites",
        "POST /v1/users/{userId}/follow",
        "DELETE /v1/users/{userId}/follow",
        "GET /v1/content/{contentId}/comments",
        "POST /v1/content/{contentId}/comments",
        "PATCH /v1/comments/{commentId}",
        "DELETE /v1/comments/{commentId}",
        "POST /v1/comments/{commentId}/likes",
        "DELETE /v1/comments/{commentId}/likes"
      ]
    },
    "notification": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/notifications",
        "POST /v1/notifications/{notificationId}/read",
        "POST /v1/notifications/read-all",
        "GET /v1/notification-preferences",
        "PATCH /v1/notification-preferences"
      ]
    },
    "search_discovery": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/search",
        "GET /v1/search/suggestions",
        "GET /v1/search/trending",
        "GET /v1/discovery/topics",
        "GET /v1/discovery/creators"
      ]
    },
    "creator_ip_mcn": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/creator/profile",
        "PATCH /v1/creator/profile",
        "GET /v1/ip/assets",
        "POST /v1/ip/assets",
        "PATCH /v1/ip/assets/{assetId}",
        "GET /v1/mcn/organizations",
        "POST /v1/mcn/organizations",
        "GET /v1/mcn/organizations/{orgId}",
        "POST /v1/mcn/organizations/{orgId}/members",
        "DELETE /v1/mcn/organizations/{orgId}/members/{userId}"
      ]
    },
    "subscription_entitlement_payment": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/subscriptions",
        "POST /v1/subscriptions",
        "DELETE /v1/subscriptions/{subscriptionId}",
        "GET /v1/entitlements",
        "GET /v1/plans",
        "POST /v1/payments/intents",
        "GET /v1/payments/{paymentId}"
      ]
    },
    "audit_compliance": {
      "required": true,
      "endpoint_groups": [
        "GET /v1/audit/events",
        "GET /v1/account/data-export",
        "POST /v1/account/data-export",
        "POST /v1/account/deletion-request"
      ]
    },
    "analytics": {
      "required": true,
      "endpoint_groups": [
        "POST /v1/analytics/events",
        "POST /v1/analytics/batch",
        "GET /v1/creator/analytics"
      ]
    },
    "recommendation_realtime": {
      "required": true,
      "endpoint_groups": [
        "POST /v1/recommendation/feedback",
        "GET /v1/recommendation/context",
        "GET /v1/realtime/session",
        "POST /v1/realtime/presence"
      ]
    },
    "open_platform": {
      "required": true,
      "endpoint_groups": [
        "POST /v1/developer/apps",
        "GET /v1/developer/apps",
        "PATCH /v1/developer/apps/{appId}",
        "POST /v1/developer/oauth/authorize",
        "POST /v1/developer/api-keys",
        "DELETE /v1/developer/api-keys/{keyId}",
        "GET /v1/developer/webhooks",
        "POST /v1/developer/webhooks",
        "DELETE /v1/developer/webhooks/{webhookId}",
        "GET /v1/developer/usage"
      ]
    }
  },
  "endpoint_record_template": {
    "method": "GET|POST|PATCH|PUT|DELETE",
    "path": "/v1/...",
    "domain": "required",
    "status": "required",
    "schema_ref": "required",
    "openapi_operation_id": "required",
    "permission_ref": "required",
    "scope_ref": "required",
    "state_machine_ref": "required_when_stateful",
    "cache_policy": "required",
    "read_write_classification": "required",
    "resource_budget_ref": "required",
    "rpc_budget": "required",
    "retry_budget": "required",
    "event_budget": "required",
    "queue_budget": "required_when_async",
    "anti_abuse_ref": "required",
    "idempotency": "required_for_repeatable_state_change",
    "mapping_ref": "required",
    "example_refs": "required",
    "integration_e2e_ref": "required_for_integrated_or_stable",
    "security_e2e_ref": "required_for_sensitive_or_privileged",
    "notes": "optional"
  }
}
