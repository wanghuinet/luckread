{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/api/api-domain-audit.v1.json",
  "title": "LuckRead API Domain Audit v1",
  "version": "1.0.0",
  "status": "NOT_GREEN",
  "rule": "An endpoint is complete only when inventory, schema, OpenAPI, authz, state, resource, mapping, integration and security evidence are present.",
  "domains": {
    "auth": {
      "status": "NOT_GREEN",
      "requiredFamilies": ["register", "login", "logout", "refresh", "sessions", "credential-lifecycle", "verification", "recovery", "mfa", "risk-challenge"],
      "openapiPresentFamilies": ["register", "login", "logout"],
      "blockingGaps": ["refresh endpoint", "session list/revoke", "credential lifecycle", "verification lifecycle", "recovery flow", "MFA/factor contract", "explicit anti-abuse/resource budgets", "security E2E evidence"]
    },
    "user-account": {
      "status": "NOT_GREEN",
      "requiredFamilies": ["me-read", "me-update", "public-profile", "username", "account-state", "preferences", "privacy", "sessions", "export", "deletion", "consent", "organization-membership"],
      "openapiPresentFamilies": ["me-read", "me-update", "account-state"],
      "blockingGaps": ["public profile endpoint", "username availability/change", "preferences/privacy", "session/device management", "export job", "deletion workflow", "consent contract", "organization membership", "security E2E evidence"]
    },
    "content": {
      "status": "NOT_GREEN",
      "requiredFamilies": ["list", "read", "create-draft", "update", "submit-review", "publish", "unpublish", "archive", "delete", "restore", "visibility", "schedule", "version-history", "moderation", "author-projection"],
      "openapiPresentFamilies": ["list", "read", "create-draft", "update", "delete", "state-transition"],
      "blockingGaps": ["review submission contract", "explicit publish/unpublish operations or state transition policy", "archive/restore semantics", "visibility policy", "scheduled publication execution contract", "version/history contract", "moderation/report contract", "projection contract", "resource budget mapping"]
    },
    "media": {
      "status": "NOT_GREEN",
      "requiredFamilies": ["upload-intent", "multipart/chunk", "asset-register", "processing-create", "processing-status", "variant-list", "playback", "signed-delivery", "metadata-update", "delete-retention", "job-retry-cancel"],
      "openapiPresentFamilies": ["upload-intent", "metadata-read"],
      "blockingGaps": ["multipart/chunk coordination", "asset registration completion", "processing job lifecycle", "variant API", "playback/delivery contract", "signed delivery policy", "metadata update", "retention/delete", "retry/cancel", "media resource budgets"]
    },
    "feed": {
      "status": "NOT_GREEN",
      "requiredFamilies": ["public", "following", "recommended", "creator", "ip", "topic", "hot", "cursor", "refresh", "eligibility", "mute-block-filter", "ranking-context"],
      "openapiPresentFamilies": ["feed-with-type", "cursor", "limit"],
      "blockingGaps": ["public cache policy", "following/recommendation isolation policy", "refresh/revalidation contract", "eligibility/safety filtering contract", "mute/block/filter integration", "ranking context contract", "bounded candidate/result budgets", "personalization cache-key contract"]
    },
    "interaction": {
      "status": "NOT_GREEN",
      "requiredFamilies": ["like", "unlike", "favorite", "unfavorite", "follow", "unfollow", "comment-create", "comment-read", "comment-update", "comment-delete", "reply/thread", "report", "block", "mute", "interaction-state", "bounded-counter-projection"],
      "openapiPresentFamilies": ["like", "unlike", "follow", "unfollow", "comment-create", "comment-read"],
      "blockingGaps": ["favorite APIs", "comment update/delete", "reply/thread contract", "report API", "block/mute APIs", "batch interaction state", "counter projection contract", "mandatory idempotency policy for repeatable mutations", "anti-abuse budgets", "security E2E evidence"]
    }
  },
  "crossCuttingBlockingGaps": [
    "No machine-readable endpoint inventory with one record per OpenAPI operation has been reconciled against all six domains.",
    "Operation policy does not yet encode resource/cache/RPC/retry/event/queue/anti-abuse fields required by the Edge-First contract.",
    "Several repeatable mutations currently declare idempotencyRequired=false and require reconciliation with the idempotency invariant.",
    "Implementation and runtime evidence cannot be inferred from OpenAPI existence.",
    "Security Green requires real authorization, IDOR, cross-scope, revocation and race E2E evidence."
  ],
  "nextGate": "Reconcile every OpenAPI operationId against this domain audit, then expand operation-policy to resource/security fields before implementation Green."
}
