{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/api/interaction-operation-policy.json",
  "title": "LuckRead Interaction API Operation Policy",
  "version": "1.0.0",
  "domain": "interaction",
  "greenRule": "Interaction is production-green only when authorization, ownership, state transitions, idempotency, concurrency, counters, abuse controls, resource budgets and runtime E2E evidence all pass.",
  "invariants": [
    "Every interaction MUST be authorized against the current subject, account state, resource policy and relationship state.",
    "Like, unlike, follow, unfollow, bookmark and equivalent toggles MUST be idempotent at the domain level even when the transport request is retried.",
    "A toggle operation MUST NOT create duplicate authoritative relationship rows.",
    "Counters are projections, not authorization truth; counter updates MUST NOT determine whether an interaction succeeded.",
    "Hot counters MUST NOT require synchronous fan-out to every feed, profile or cache projection.",
    "Comment creation MUST enforce content policy, parent ownership/scope, state and anti-abuse before the authoritative write.",
    "Replies MUST be bounded in depth and page size; recursive unbounded comment trees are forbidden in a single request.",
    "Block and mute rules MUST be applied before exposing social relationships or interaction results where applicable.",
    "Client-supplied actor, owner, counter or moderation state MUST never be trusted.",
    "Interaction mutations MUST use optimistic concurrency or atomic uniqueness/state constraints where races are possible.",
    "Synchronous event fan-out is forbidden for ordinary interactions; downstream feed, notification, analytics and counter projections are asynchronous and bounded.",
    "Abuse controls MUST execute before expensive database writes whenever possible."
  ],
