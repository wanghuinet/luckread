{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckread.com/contracts/v1/api/rc-04-06-share-subscription-entitlement.json",
  "title": "RC-04..RC-06 Share, Subscription and Entitlement API Contract",
  "version": "1.0.0",
  "operations": [
    {
      "operationId": "createShare",
      "method": "POST",
      "path": "/content/{contentId}/shares",
      "auth": {
        "required": true,
        "permission": "share.create",
        "scope": "self"
      },
      "request": {
        "required": [
          "contentId"
        ]
      },
      "success": {
        "status": 201,
        "idempotent": true
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "CONFLICT"
      ]
    },
    {
      "operationId": "resolveShare",
      "method": "GET",
      "path": "/shares/{shareId}",
      "auth": {
        "required": false,
        "permission": "share.resolve",
        "scope": "public-or-scoped"
      },
      "success": {
        "status": 200
      },
      "errors": [
        "RESOURCE_NOT_FOUND",
        "INVALID_STATE"
      ]
    },
    {
      "operationId": "createSubscription",
      "method": "POST",
      "path": "/memberships/subscriptions",
      "auth": {
        "required": true,
        "permission": "subscription.create",
        "scope": "self-or-organization"
      },
      "request": {
        "required": [
          "planId"
        ]
      },
      "success": {
        "status": 201,
        "idempotent": true
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "INVALID_STATE",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "CONFLICT"
      ]
    },
    {
      "operationId": "cancelSubscription",
      "method": "POST",
      "path": "/memberships/subscriptions/{subscriptionId}/cancel",
      "auth": {
        "required": true,
        "permission": "subscription.cancel",
        "scope": "self-or-organization"
      },
      "request": {
        "headers": {
          "If-Match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "success": {
        "status": 200,
        "idempotent": true
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "PRECONDITION_REQUIRED",
        "PRECONDITION_FAILED",
        "INVALID_STATE",
        "CONFLICT"
      ],
      "concurrency": {
        "strategy": "ETAG_COMPARE_AND_SWAP"
      }
    },
    {
      "operationId": "pauseSubscription",
      "method": "POST",
      "path": "/memberships/subscriptions/{subscriptionId}/pause",
      "auth": {
        "required": true,
        "permission": "subscription.pause",
        "scope": "self-or-organization"
      },
      "request": {
        "headers": {
          "If-Match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "success": {
        "status": 200,
        "idempotent": true
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "PRECONDITION_REQUIRED",
        "PRECONDITION_FAILED",
        "INVALID_STATE",
        "CONFLICT"
      ],
      "concurrency": {
        "strategy": "ETAG_COMPARE_AND_SWAP"
      }
    },
    {
      "operationId": "resumeSubscription",
      "method": "POST",
      "path": "/memberships/subscriptions/{subscriptionId}/resume",
      "auth": {
        "required": true,
        "permission": "subscription.resume",
        "scope": "self-or-organization"
      },
      "request": {
        "headers": {
          "If-Match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "success": {
        "status": 200,
        "idempotent": true
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "PRECONDITION_REQUIRED",
        "PRECONDITION_FAILED",
        "INVALID_STATE",
        "CONFLICT"
      ],
      "concurrency": {
        "strategy": "ETAG_COMPARE_AND_SWAP"
      }
    },
    {
      "operationId": "changeSubscriptionPlan",
      "method": "POST",
      "path": "/memberships/subscriptions/{subscriptionId}/change-plan",
      "auth": {
        "required": true,
        "permission": "subscription.change_plan",
        "scope": "self-or-organization"
      },
      "request": {
        "required": [
          "planId"
        ],
        "headers": {
          "If-Match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "Idempotency-Key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "success": {
        "status": 201,
        "replayStatus": 200,
        "idempotent": true,
        "response": "Payment-required checkout Order; subscription state and entitlement remain unchanged until verified successful Hyperswitch webhook fulfillment."
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "PRECONDITION_REQUIRED",
        "PRECONDITION_FAILED",
        "INVALID_STATE",
        "VALIDATION_FAILED",
        "CONFLICT",
        "PAYMENT_REQUIRED",
        "SERVICE_UNAVAILABLE",
        "BILLING_INTERVAL_CHANGE_REQUIRED"
      ],
      "concurrency": {
        "strategy": "ETAG_COMPARE_AND_SWAP",
        "idempotency": "SUBSCRIPTION_SOURCE_VERSION_BOUND_ORDER"
      },
      "fulfillment": {
        "paymentAuthority": "W07 D1-04 confirmed Order + Payment + immutable OrderLine snapshot",
        "subscriptionAuthority": "W07 applies D1-01 subscription version CAS and immutable plan-change receipt only after verified payment_succeeded",
        "auditAuthority": "W01 persists the final membership.subscription.plan_changed audit in W06 D1-03 before acknowledging the provider webhook",
        "failure": "Failed, pending, stale or ambiguous payment leaves the current Subscription and Entitlement unchanged; missing W06 confirmation leaves the webhook retryable",
        "duplicate": "Immutable D1-01 plan-change receipt and deterministic W06 event ID make provider replay idempotent"
      }
    },
    {
      "operationId": "getSubscriptionPlanChangeQuote",
      "method": "GET",
      "path": "/memberships/subscriptions/{subscriptionId}/change-plan/quote",
      "auth": {
        "required": true,
        "permission": "subscription.read",
        "scope": "self"
      },
      "request": {
        "query": {
          "planId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "headers": {
          "If-Match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "success": {
        "status": 200,
        "readOnly": true,
        "quoteOnly": true,
        "noPaymentOrEntitlementMutation": true,
        "taxStatus": "NOT_CALCULATED"
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "PRECONDITION_REQUIRED",
        "PRECONDITION_FAILED",
        "INVALID_STATE",
        "VALIDATION_FAILED",
        "CONFLICT"
      ],
      "concurrency": {
        "strategy": "ETAG_VERSION_PRECONDITION"
      }
    },
    {
      "operationId": "listMembershipSubscriptions",
      "method": "GET",
      "path": "/memberships/subscriptions",
      "auth": {
        "required": true,
        "permission": "subscription.read",
        "scope": "self"
      },
      "request": {
        "query": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          }
        }
      },
      "success": {
        "status": 200
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "VALIDATION_FAILED",
        "RATE_LIMITED"
      ]
    },
    {
      "operationId": "getSubscription",
      "method": "GET",
      "path": "/memberships/subscriptions/{subscriptionId}",
      "auth": {
        "required": true,
        "permission": "subscription.read",
        "scope": "self-or-organization"
      },
      "success": {
        "status": 200
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND"
      ]
    },
    {
      "operationId": "getEntitlements",
      "method": "GET",
      "path": "/entitlements/{subjectId}",
      "auth": {
        "required": true,
        "permission": "entitlement.read",
        "scope": "self-or-organization"
      },
      "success": {
        "status": 200
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND"
      ]
    },
    {
      "operationId": "checkEntitlement",
      "method": "POST",
      "path": "/entitlements/check",
      "auth": {
        "required": true,
        "permission": "entitlement.check",
        "scope": "self-or-organization"
      },
      "request": {
        "required": [
          "subjectId",
          "entitlement"
        ]
      },
      "success": {
        "status": 200
      },
      "errors": [
        "AUTH_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "INVALID_STATE",
        "VALIDATION_FAILED"
      ]
    }
  ],
  "globalInvariants": [
    "tenant/organization scope is enforced",
    "server-owned security fields cannot be client-written",
    "state transitions must conform to subscription state machine",
    "all mutating operations are auditable",
    "payment does not become entitlement authority"
  ],
  "greenEvidence": {
    "openapi": "required",
    "permission": "required",
    "state": "required",
    "idempotency": "required",
    "entitlementFailClosed": "required",
    "audit": "required",
    "securityE2E": "required"
  },
  "status": "CONTRACT_COMPLETE_IMPLEMENTATION_PENDING"
}
