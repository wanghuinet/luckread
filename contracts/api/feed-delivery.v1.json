{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/api/feed-delivery.v1.json",
  "title":"Feed Delivery Contract",
  "version":"1.0.0",
  "operations":[{"id":"feed.list","method":"GET","path":"/v1/feed","auth":"public-or-scoped","rules":["cursor pagination is mandatory","ordering is deterministic within a rankingVersion and request snapshot","same item identity must not appear twice in one page","cursor is opaque and server-owned","invalid or expired cursor fails closed"]}],
  "ordering":{"requiredTieBreakers":["rankingScore","publishedAt","contentId"],"direction":"descending","stableAcrossPageTraversal":true,"rankingVersionRequired":true},
  "dedup":{"identity":"contentId","scope":"single-response-and-page-traversal","duplicatePolicy":"drop-later-occurrence"},
  "cursor":{"opaque":true,"bindsTo":["feedType","rankingVersion","snapshot","filters"],"tamperHandling":"INVALID_CURSOR","expiryRequired":true},
  "invariants":["no duplicate content in one logical feed traversal","no client-controlled ranking authority","visibility/moderation/entitlement are evaluated before delivery","pagination cannot leak unauthorized content","feed materialization creates no new content authority"],
  "status":"CONTRACT_COMPLETE_IMPLEMENTATION_PENDING"
}