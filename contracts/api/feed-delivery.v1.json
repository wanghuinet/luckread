{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luckread.com/contracts/v1/api/feed-delivery.json",
  "title":"LuckRead Feed Delivery API Contract",
  "version":"1.0.0",
  "domain":"feed",
  "purpose":"Production feed delivery semantics subordinate to canonical OpenAPI and recommendation contracts.",
  "invariants":["cursor pagination is mandatory","ordering is deterministic within rankingVersion and request snapshot","contentId cannot repeat within one logical feed traversal","cursor is opaque, server-owned and context-bound","visibility, moderation and entitlement are evaluated before delivery","feed materialization creates no new content authority","client cannot control authoritative ranking score"],
  "operations":[{"operationId":"getFeed","method":"GET","path":"/feed","auth":{"required":false,"permission":"feed.read","scope":"viewer"},"parameters":["type","cursor","limit"],"success":{"status":200,"idempotent":false},"errors":["INVALID_CURSOR","PERMISSION_DENIED","RATE_LIMITED","SERVICE_UNAVAILABLE"],"cache":{"mode":"AUTHORIZATION_AWARE","shared":false},"ordering":{"tieBreakers":["rankingScore","publishedAt","contentId"],"direction":"descending","rankingVersionRequired":true},"dedup":{"identity":"contentId","scope":"logical-feed-traversal","duplicatePolicy":"drop-later-occurrence"},"cursor":{"opaque":true,"bindsTo":["feedType","rankingVersion","snapshot","filters"],"tamperHandling":"INVALID_CURSOR","expiryRequired":true}}],
  "definitions":{"ResourceId":{"type":"string","minLength":1,"maxLength":128}},
  "greenEvidence":{"openapi":"required","permission":"required","cursorStability":"required","deduplication":"required","authorizationFiltering":"required","securityE2E":"required"}
