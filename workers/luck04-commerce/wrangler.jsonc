{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luck04-commerce",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "services": [
    {
      "binding": "W03_CONTENT_MODERATION",
      "service": "luck02-content"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIPTION_ORIGIN_GLOBAL_LIMITER",
      "namespace_id": "2026100313",
      "simple": { "limit": 3000, "period": 60 }
    },
    {
      "name": "SUBSCRIPTION_READ_LIMITER",
      "namespace_id": "2026100314",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "SUBSCRIPTION_WRITE_LIMITER",
      "namespace_id": "2026100315",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "D1_01",
      "database_name": "luckread",
      "database_id": "2f80471e-3756-49f9-8db1-7707a433ad64",
      "migrations_dir": "migrations"
    },
    {
      "binding": "D1_03",
      "database_name": "secondary",
      "database_id": "bda1d247-a371-4244-91ae-aef96034db7f",
      "migrations_dir": "governance/migrations"
    },
    {
      "binding": "D1_04_TARGET",
      "database_name": "unimportant",
      "database_id": "9bfb89a5-fbb5-45b1-a2ee-eab674b0d736"
    }
  ],
  "vars": {
    "LUCKREAD_D1_MODE": "legacy"
  }

}
