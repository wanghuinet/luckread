{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "luckread-w01-payload",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "W02_AUTH",
      "service": "luckread-w02"
    },
    {
      "binding": "W03_CONTENT",
      "service": "luckread-w03"
    },
    {
      "binding": "W06_MODERATION",
      "service": "luckread-w06"
    }
  ],  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "2f80471e-3756-49f9-8db1-7707a433ad64",
      "database_name": "luckread",
      "remote": true
    }
  ],
  "routes": [
    {
      "pattern": "luckread.cn",
      "custom_domain": true
    },
    {
      "pattern": "api.luckread.cn",
      "custom_domain": true
    },
    {
      "pattern": "www.luckread.cn",
      "custom_domain": true
    },
    {
      "pattern": "sso.luckread.cn",
      "custom_domain": true
    },
    {
      "pattern": "mp.luckread.cn",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "luckread-w01-assets-placeholder"
    }
  ]
}
