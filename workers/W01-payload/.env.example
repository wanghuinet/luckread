# W01 Payload local development
PAYLOAD_SECRET=replace-with-a-local-development-secret
CLOUDFLARE_ENV=dev

# Optional scheduled publishing trigger (keep empty until a protected cron is configured)
CRON_SECRET=

# Optional GA4 admin analytics integration (all four values are required to activate it)
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
