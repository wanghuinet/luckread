{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luckread-w02",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@good.luckread.com",
    "W02_DATABASE_DRIVER": "neon"
  },
  "ratelimits": [
    {
      "name": "AUTH_SESSION_READ_LIMITER",
      "namespace_id": "2026100312",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "AUTH_SESSION_WRITE_LIMITER",
      "namespace_id": "2026100320",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "AUTH013_QUEUE",
        "queue": "luckread-auth013-account-state"
      },
      {
        "binding": "AUTH013_PROJECTION_QUEUE",
        "queue": "luckread-auth013-account-state-projection"
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0c53a1bb9bc0484bac146e8ae2d3158b"
    }
  ]
}
