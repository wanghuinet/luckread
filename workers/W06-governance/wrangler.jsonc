{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luckread-w06",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-15",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "GOVERNANCE_ORIGIN_GLOBAL_LIMITER",
      "namespace_id": "2026100316",
      "simple": { "limit": 3000, "period": 60 }
    },
    {
      "name": "GOVERNANCE_READ_LIMITER",
      "namespace_id": "2026100317",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "GOVERNANCE_WRITE_LIMITER",
      "namespace_id": "2026100318",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "luckread-auth013-account-state",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "luckread-auth013-account-state-dlq"
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_NEON_GOVERNANCE",
      "id": "7c8831416c18494faee04b96aa551cb9"
    }
  ],
  "services": [
    {
      "binding": "W03_CONTENT_MODERATION",
      "service": "luckread-w03"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
