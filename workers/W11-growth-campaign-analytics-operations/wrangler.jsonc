{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luckread-w11",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "W11_DATABASE_DRIVER": "neon",
    "W11_ANALYTICS_INGEST_ENABLED": "false"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_ANALYTICS_PG",
      "id": "3eb2012cfbb04e429e18f8349377ffbc"
    }
  ]
}
