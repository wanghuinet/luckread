{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luckread-w03",
  "main": "src/entry.ts",
  "compatibility_date": "2025-08-15",
  "services": [
    {
      "binding": "W07_SUBSCRIPTION",
      "service": "luckread-w07"
    }
  ],
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "CONTENT_ORIGIN_GLOBAL_LIMITER",
      "namespace_id": "2026100308",
      "simple": {
        "limit": 10000,
        "period": 60
      }
    },
    {
      "name": "CONTENT_PUBLIC_READ_LIMITER",
      "namespace_id": "2026100301",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "CONTENT_MUTATION_LIMITER",
      "namespace_id": "2026100302",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_CONTENT_PG",
      "id": "c55183e1cc3446409c9c1075832c6615"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "W03_CONTENT_READ_DRIVER": "neon"
  }
}
