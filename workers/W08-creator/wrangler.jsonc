{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luckread-w08-creator",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "services": [
    {
      "binding": "W02_AUTH",
      "service": "luckread-w02"
    }
  ],
  "vars": {
    "W08_DATABASE_DRIVER": "neon"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0c53a1bb9bc0484bac146e8ae2d3158b"
    }
  ]
}
