{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luckread-w07",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "MEMBERSHIP_RENEWAL_ENABLED": "false",
    "W07_DATABASE_DRIVER": "neon",
    "W07_MEMBERSHIP_DATABASE_DRIVER": "neon"
  },
  "ratelimits": [
    {
      "name": "SUBSCRIPTION_ORIGIN_GLOBAL_LIMITER",
      "namespace_id": "2026100313",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIPTION_READ_LIMITER",
      "namespace_id": "2026100314",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIPTION_WRITE_LIMITER",
      "namespace_id": "2026100315",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "W06_GOVERNANCE",
      "service": "luckread-w06"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_D1_04",
      "id": "3ae15e6dfb5e4b44979eee30e1d5ede4"
    },
    {
      "binding": "HYPERDRIVE_D1_01",
      "id": "0c53a1bb9bc0484bac146e8ae2d3158b"
    }
  ]
}
