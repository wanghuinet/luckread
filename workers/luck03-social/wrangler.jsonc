{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luck03-social",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "SOCIAL_ORIGIN_GLOBAL_LIMITER",
      "namespace_id": "2026100309",
      "simple": { "limit": 10000, "period": 60 }
    },
    {
      "name": "SOCIAL_READ_LIMITER",
      "namespace_id": "2026100303",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "SOCIAL_WRITE_LIMITER",
      "namespace_id": "2026100304",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH013_W04_DERIVED_PROJECTION",
      "id": "32f7e407128a43d59720d5d46736e084"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "luckread-auth013-account-state-projection",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "luckread-auth013-account-state-projection-dlq"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "6c342634-97f6-4248-9f4a-85772af4f22c",
      "database_name": "luckreadpro"
    },
    {
      "binding": "D1_03_TARGET",
      "database_id": "bda1d247-a371-4244-91ae-aef96034db7f",
      "database_name": "secondary"
    }
  ],
  "vars": {
    "LUCKREAD_D1_MODE": "legacy"
  }

}
